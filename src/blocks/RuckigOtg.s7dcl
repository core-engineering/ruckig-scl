{
    S7_Author := "Martin C";
    S7_EditorMode := "SCL";
    S7_Family := "Ruckig";
    S7_Optimized := "TRUE";
    S7_Version := "0.8.0"
}
FUNCTION_BLOCK "RuckigOtg"
    VAR_INPUT
        enable    : Bool := false;
        input     : _.typeRuckigInput;
        cycleTime : LReal := 0.010;
        reset     : Bool := false;
    END_VAR
    VAR_OUTPUT
        valid  : Bool := false;
        busy   : Bool := false;
        done   : Bool := false;
        error  : Bool := false;
        status : Word := 16#0000;
        output : _.typeRuckigOutput;
    END_VAR
    VAR
        trajectory : _.typeTrajectory;
        prevInput  : _.typeRuckigInput;
        firstCall  : Bool := true;
        // pass_to_input chain state, per DoF: last commanded setpoint, seeds the
        // next solve so a retarget is C2-continuous (no jump on each axis).
        chainPos   : Array[0..3] of LReal;
        chainVel   : Array[0..3] of LReal;
        chainAcc   : Array[0..3] of LReal;
        // per-DoF reachable-duration blocks (multi-axis time synchronization)
        blockSet   : _.typeBlockSet;
    END_VAR
    VAR_TEMP
        validationResult  : Word;
        profileResult     : Word;
        recomputeRequired : Bool;
        nd                : Int;       // resolved DoF count (1..4)
        ax                : Int;       // DoF loop index
        multiPath         : Bool;      // multi-axis / minimumDuration path
        // brake pre-phase scratch (single-axis path)
        brakeDuration : LReal;
        // main solve seed state (post-brake)
        mainP0 : LReal;
        mainV0 : LReal;
        mainA0 : LReal;
        // duration accumulation
        mainDuration : LReal;
        brakeDur     : Array[0..3] of LReal;   // per-axis brake duration (multi-axis flow; cf. scalar brakeDuration for single-axis)
        i            : DInt;
        // already-at-target degenerate guard
        atTarget : Bool;
        // multi-axis scratch
        blockResult  : Word;
        syncOk       : Bool;
        tSync        : LReal;
        limitingAxis : Int;
        syncHandled  : Bool;
        axDur        : LReal;
        phaseDur     : LReal;    // PhaseSynchronize output: common phase duration
        phaseDone    : Bool;     // PhaseSynchronize output: phase sync succeeded
        // StateAtTime sampling scratch
        op : LReal;
        ov : LReal;
        oa : LReal;
        // per-axis unified flow
        modeEff      : Array[0..3] of Int;
        participates : Array[0..3] of Bool;
        isDiscrete   : Bool;
        tinMoving    : Bool;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        REGION Block header
            //==========================================================
            // Title:      RuckigOtg
            // Function:   Online Trajectory Generator (PLCopen DA011).
            //             Called once per PLC cycle while enabled; emits a
            //             jerk-limited MULTI-DoF trajectory toward arbitrary
            //             target states (pos/vel/acc per axis), time-
            //             synchronized so every axis reaches its target at the
            //             same instant. pass_to_input chaining (C2 retarget).
            //             valid/busy/done/error + DA014 status.
            // Solver:     1-DoF (no minimumDuration) -> v0.3 step1 stack
            //             (ComputeBrakeProfile + ComputeProfile1Axis).
            //             Multi-DoF / minimumDuration -> v0.4: ComputeBlock1Axis
            //             per axis -> Synchronize (t_sync) -> ComputeProfile1-
            //             AxisTimed(tf = t_sync) per axis (step2 re-time).
            // Family:     Ruckig
            // Author:     Martin C
            //==========================================================
        END_REGION

        REGION Disabled - force outputs and reset
            IF NOT #enable THEN
                #valid := false;
                #busy := false;
                #done := false;
                #error := false;
                #status := "dbRuckigConst".RESULT_FINISHED;
                #firstCall := true;
                #trajectory.isValid := false;
                RETURN;
            END_IF;
        END_REGION

        REGION Validation
            #validationResult := "ValidateInput"(input := #input);
            IF #validationResult <> "dbRuckigConst".RESULT_WORKING THEN
                #valid := false;
                #busy := false;
                #done := false;
                #error := true;
                #status := #validationResult;
                RETURN;
            END_IF;
        END_REGION

        REGION Resolve DoF count (clamp to 1..4)
            #nd := DINT_TO_INT(#input.nDofs);
            IF #nd < 1 THEN
                #nd := 1;
            END_IF;
            IF #nd > 4 THEN
                #nd := 4;
            END_IF;
            #multiPath := #nd > 1 OR #input.minimumDuration >= 0.0;
        END_REGION

        REGION First enable - seed chain from real axis state (all DoFs)
            IF #firstCall THEN
                FOR #ax := 0 TO #nd - 1 DO
                    #chainPos[#ax] := #input.currentPosition[#ax];
                    #chainVel[#ax] := #input.currentVelocity[#ax];
                    #chainAcc[#ax] := #input.currentAcceleration[#ax];
                END_FOR;
            END_IF;
        END_REGION

        REGION Change detection (any DoF target/limit moved)
            // firstCall/reset/invalid force a recompute WITHOUT reading prevInput
            // (which is uninitialized on the first cycle). Only diff against
            // prevInput once it holds a committed input.
            #recomputeRequired := #firstCall OR #reset OR NOT #trajectory.isValid;
            IF NOT #recomputeRequired THEN
                FOR #ax := 0 TO #nd - 1 DO
                    IF ABS(#input.targetPosition[#ax] - #prevInput.targetPosition[#ax]) > "dbRuckigConst".EPS_POSITION THEN
                        #recomputeRequired := true;
                    END_IF;
                    IF ABS(#input.targetVelocity[#ax] - #prevInput.targetVelocity[#ax]) > "dbRuckigConst".EPS_VELOCITY THEN
                        #recomputeRequired := true;
                    END_IF;
                    IF ABS(#input.targetAcceleration[#ax] - #prevInput.targetAcceleration[#ax]) > "dbRuckigConst".EPS_DERIV THEN
                        #recomputeRequired := true;
                    END_IF;
                    IF ABS(#input.maxVelocity[#ax] - #prevInput.maxVelocity[#ax]) > "dbRuckigConst".EPS_VELOCITY THEN
                        #recomputeRequired := true;
                    END_IF;
                    IF ABS(#input.maxAcceleration[#ax] - #prevInput.maxAcceleration[#ax]) > "dbRuckigConst".EPS_DERIV THEN
                        #recomputeRequired := true;
                    END_IF;
                    IF ABS(#input.maxJerk[#ax] - #prevInput.maxJerk[#ax]) > "dbRuckigConst".EPS_DERIV THEN
                        #recomputeRequired := true;
                    END_IF;
                END_FOR;
                IF ABS(#input.minimumDuration - #prevInput.minimumDuration) > "dbRuckigConst".EPS_TIME THEN
                    #recomputeRequired := true;
                END_IF;
                IF #input.synchronization <> #prevInput.synchronization THEN
                    #recomputeRequired := true;
                END_IF;
                IF #input.durationDiscretization <> #prevInput.durationDiscretization THEN
                    #recomputeRequired := true;
                END_IF;
                IF #input.controlInterface <> #prevInput.controlInterface THEN
                    #recomputeRequired := true;
                END_IF;
                FOR #ax := 0 TO #nd - 1 DO
                    IF #input.perDofSynchronization[#ax] <> #prevInput.perDofSynchronization[#ax] THEN
                        #recomputeRequired := true;
                    END_IF;
                END_FOR;
            END_IF;
        END_REGION

        REGION Recompute trajectory
            IF #recomputeRequired THEN
                // IFACE_VELOCITY = 1. Literal used because the transpiler mis-lexes
                // any identifier starting with "IF" (so "dbRuckigConst".IFACE_VELOCITY
                // is unusable here); see dbRuckigConst for the authoritative constant.
                IF #input.controlInterface = 1 THEN
                    //====================================================
                    // VELOCITY INTERFACE PATH (v0.7) — all DoF counts
                    //====================================================
                    // 1. resolve effective mode + participation per axis
                    //    (Phase -> Time; velocity has no phase sync)
                    FOR #ax := 0 TO #nd - 1 DO
                        IF #input.perDofSynchronization[#ax] >= 0 THEN
                            #modeEff[#ax] := #input.perDofSynchronization[#ax];
                        ELSE
                            #modeEff[#ax] := #input.synchronization;
                        END_IF;
                        IF #modeEff[#ax] = "dbRuckigConst".SYNC_PHASE THEN
                            #modeEff[#ax] := "dbRuckigConst".SYNC_TIME;
                        END_IF;
                        #participates[#ax] := #modeEff[#ax] <> "dbRuckigConst".SYNC_NONE;
                    END_FOR;

                    // 2. Block every axis (No axes' tMin still sets the t_sync floor)
                    FOR #ax := 0 TO #nd - 1 DO
                        #blockResult := "ComputeVelBlock1Axis"(
                            block := #blockSet.items[#ax],
                            profile := #trajectory.profiles[#ax],
                            p0 := #chainPos[#ax], v0 := #chainVel[#ax], a0 := #chainAcc[#ax],
                            vf := #input.targetVelocity[#ax],
                            af := #input.targetAcceleration[#ax],
                            aMax := #input.maxAcceleration[#ax],
                            jMax := #input.maxJerk[#ax]);
                        IF #blockResult <> "dbRuckigConst".RESULT_WORKING THEN
                            #valid := false;
                            #busy := false;
                            #done := false;
                            #error := true;
                            #status := "dbRuckigConst".RESULT_ERR_TRAJ;
                            #trajectory.isValid := false;
                            RETURN;
                        END_IF;
                    END_FOR;

                    // 3. t_sync over participating axes (+ discrete; minimumDuration honoured via Synchronize)
                    #isDiscrete := #input.durationDiscretization = "dbRuckigConst".DISC_DISCRETE;
                    "Synchronize"(
                        blockSet := #blockSet,
                        nDofs := #nd,
                        minimumDuration := #input.minimumDuration,
                        participates := #participates,
                        discrete := #isDiscrete,
                        cycleTime := #cycleTime,
                        resolved => #syncOk,
                        tSync => #tSync,
                        limitingAxis => #limitingAxis);
                    IF NOT #syncOk THEN
                        #valid := false;
                        #busy := false;
                        #done := false;
                        #error := true;
                        #status := "dbRuckigConst".RESULT_ERR_SYNC;
                        #trajectory.isValid := false;
                        RETURN;
                    END_IF;

                    // 4. emit per axis — velocity interface has no at-target
                    //    degenerate shortcut: the target velocity may be non-zero,
                    //    so "arrived" is not a useful concept. ComputeVelProfileTimed
                    //    always re-solves to tf (its trivial time_none case coasts an
                    //    already-at-target axis at constant velocity for tf).
                    #mainDuration := 0.0;
                    FOR #ax := 0 TO #nd - 1 DO
                        #trajectory.profiles[#ax].brake.t[0] := 0.0;
                        #trajectory.profiles[#ax].brake.t[1] := 0.0;
                        #trajectory.profiles[#ax].brake.j[0] := 0.0;
                        #trajectory.profiles[#ax].brake.j[1] := 0.0;
                        #trajectory.profiles[#ax].brake.a[0] := 0.0;
                        #trajectory.profiles[#ax].brake.a[1] := 0.0;
                        #trajectory.profiles[#ax].brake.a[2] := 0.0;
                        #trajectory.profiles[#ax].brake.v[0] := 0.0;
                        #trajectory.profiles[#ax].brake.v[1] := 0.0;
                        #trajectory.profiles[#ax].brake.v[2] := 0.0;
                        #trajectory.profiles[#ax].brake.p[0] := 0.0;
                        #trajectory.profiles[#ax].brake.p[1] := 0.0;
                        #trajectory.profiles[#ax].brake.p[2] := 0.0;

                        #tinMoving := #modeEff[#ax] = "dbRuckigConst".SYNC_TIME;
                        IF #modeEff[#ax] = "dbRuckigConst".SYNC_TIME_IF_NECESSARY THEN
                            IF ABS(#input.targetVelocity[#ax]) > "dbRuckigConst".EPS_VELOCITY
                                OR ABS(#input.targetAcceleration[#ax]) > "dbRuckigConst".EPS_DERIV THEN
                                #tinMoving := true;
                            END_IF;
                        END_IF;

                        IF #tinMoving THEN
                            #axDur := #tSync;
                        ELSE
                            #axDur := #blockSet.items[#ax].tMin;
                        END_IF;

                        #profileResult := "ComputeVelProfileTimed"(
                            profile := #trajectory.profiles[#ax],
                            p0 := #chainPos[#ax], v0 := #chainVel[#ax], a0 := #chainAcc[#ax],
                            vf := #input.targetVelocity[#ax],
                            af := #input.targetAcceleration[#ax],
                            aMax := #input.maxAcceleration[#ax],
                            jMax := #input.maxJerk[#ax],
                            tf := #axDur);
                        IF #profileResult <> "dbRuckigConst".RESULT_WORKING AND #profileResult <> "dbRuckigConst".RESULT_FINISHED THEN
                            #valid := false;
                            #busy := false;
                            #done := false;
                            #error := true;
                            #status := "dbRuckigConst".RESULT_ERR_TRAJ;
                            #trajectory.isValid := false;
                            RETURN;
                        END_IF;

                        IF #participates[#ax] THEN
                            #trajectory.independentMinDurations[#ax] := #blockSet.items[#ax].tMin;
                        ELSE
                            #trajectory.independentMinDurations[#ax] := #axDur;
                        END_IF;
                        IF #axDur > #mainDuration THEN
                            #mainDuration := #axDur;
                        END_IF;
                    END_FOR;
                    #trajectory.duration := #mainDuration;

                ELSE
                //========================================================
                // SINGLE-AXIS PATH (1 DoF, no minimumDuration) -> v0.3 stack
                //========================================================
                IF NOT #multiPath THEN
                    // ---- Already-at-target degenerate case -----------------
                    #atTarget :=
                        ABS(#input.targetPosition[0] - #chainPos[0]) < "dbRuckigConst".EPS_POSITION
                        AND ABS(#input.targetVelocity[0] - #chainVel[0]) < "dbRuckigConst".EPS_VELOCITY
                        AND ABS(#input.targetAcceleration[0] - #chainAcc[0]) < "dbRuckigConst".EPS_DERIV
                        AND ABS(#chainVel[0]) < "dbRuckigConst".EPS_VELOCITY
                        AND ABS(#chainAcc[0]) < "dbRuckigConst".EPS_DERIV;
                    IF #atTarget THEN
                        FOR #i := 0 TO 6 DO
                            #trajectory.profiles[0].t[#i] := 0.0;
                            #trajectory.profiles[0].j[#i] := 0.0;
                        END_FOR;
                        FOR #i := 0 TO 7 DO
                            #trajectory.profiles[0].a[#i] := #chainAcc[0];
                            #trajectory.profiles[0].v[#i] := #chainVel[0];
                            #trajectory.profiles[0].p[#i] := #chainPos[0];
                        END_FOR;
                        #trajectory.profiles[0].brake.t[0] := 0.0;
                        #trajectory.profiles[0].brake.t[1] := 0.0;
                        #trajectory.profiles[0].brake.j[0] := 0.0;
                        #trajectory.profiles[0].brake.j[1] := 0.0;
                        #trajectory.profiles[0].brake.a[0] := 0.0;
                        #trajectory.profiles[0].brake.a[1] := 0.0;
                        #trajectory.profiles[0].brake.a[2] := 0.0;
                        #trajectory.profiles[0].brake.v[0] := 0.0;
                        #trajectory.profiles[0].brake.v[1] := 0.0;
                        #trajectory.profiles[0].brake.v[2] := 0.0;
                        #trajectory.profiles[0].brake.p[0] := 0.0;
                        #trajectory.profiles[0].brake.p[1] := 0.0;
                        #trajectory.profiles[0].brake.p[2] := 0.0;
                        #trajectory.duration := 0.0;
                        #trajectory.independentMinDurations[0] := 0.0;
                    END_IF;

                    // ---- Brake + solve (only when NOT already at target) ---
                    IF NOT #atTarget THEN
                        // v0.9: Always compute the brake profile unconditionally
                        // (mirrors the oracle: Ruckig always calls
                        // get_position_brake_trajectory regardless of whether
                        // limits are exceeded). Returns 0 when no brake is needed;
                        // sets profile.brake.{t,j,a,v,p} and the post-brake state
                        // in profile.brake.v[2]/a[2]/p[2].
                        // NOTE: transpiler quirk — do NOT use "=>" VAR_OUTPUT
                        // bindings when consuming the return value; read the
                        // post-brake state from profile.brake (VAR_IN_OUT).
                        #brakeDuration := "ComputeBrakeProfile"(
                            profile := #trajectory.profiles[0],
                            v0 := #chainVel[0],
                            a0 := #chainAcc[0],
                            vMax := #input.maxVelocity[0],
                            aMax := #input.maxAcceleration[0],
                            jMax := #input.maxJerk[0]);
                        #mainP0 := #chainPos[0] + #trajectory.profiles[0].brake.p[2];
                        #mainV0 := #trajectory.profiles[0].brake.v[2];
                        #mainA0 := #trajectory.profiles[0].brake.a[2];

                        #profileResult := "ComputeProfile1Axis"(profile := #trajectory.profiles[0], p0 := #mainP0, v0 := #mainV0, a0 := #mainA0, pT := #input.targetPosition[0], vT := #input.targetVelocity[0], aT := #input.targetAcceleration[0], vMax := #input.maxVelocity[0], aMax := #input.maxAcceleration[0], jMax := #input.maxJerk[0]);
                        IF #profileResult <> "dbRuckigConst".RESULT_WORKING AND #profileResult <> "dbRuckigConst".RESULT_FINISHED THEN
                            #valid := false;
                            #busy := false;
                            #done := false;
                            #error := true;
                            #status := "dbRuckigConst".RESULT_ERR_TRAJ;
                            #trajectory.isValid := false;
                            RETURN;
                        END_IF;

                        #mainDuration := 0.0;
                        FOR #i := 0 TO 6 DO
                            #mainDuration := #mainDuration + #trajectory.profiles[0].t[#i];
                        END_FOR;
                        #trajectory.duration := #brakeDuration + #mainDuration;
                        #trajectory.independentMinDurations[0] := #trajectory.duration;
                    END_IF;
                END_IF;

                //========================================================
                // MULTI-AXIS PATH (>1 DoF or minimumDuration set) -> v0.4
                //========================================================
                IF #multiPath THEN
                    #syncHandled := false;

                    // ---- SYNC_PHASE: try phase sync, else fall through to Time --
                    IF #input.synchronization = "dbRuckigConst".SYNC_PHASE THEN
                        "PhaseSynchronize"(trajectory := #trajectory,
                            chainPos := #chainPos, chainVel := #chainVel, chainAcc := #chainAcc,
                            input := #input, nDofs := #nd,
                            phaseOk => #phaseDone, duration => #phaseDur);
                        IF #phaseDone THEN
                            FOR #ax := 0 TO #nd - 1 DO
                                #trajectory.profiles[#ax].brake.t[0] := 0.0;
                                #trajectory.profiles[#ax].brake.t[1] := 0.0;
                                #trajectory.profiles[#ax].brake.j[0] := 0.0;
                                #trajectory.profiles[#ax].brake.j[1] := 0.0;
                                #trajectory.profiles[#ax].brake.a[0] := 0.0;
                                #trajectory.profiles[#ax].brake.a[1] := 0.0;
                                #trajectory.profiles[#ax].brake.a[2] := 0.0;
                                #trajectory.profiles[#ax].brake.v[0] := 0.0;
                                #trajectory.profiles[#ax].brake.v[1] := 0.0;
                                #trajectory.profiles[#ax].brake.v[2] := 0.0;
                                #trajectory.profiles[#ax].brake.p[0] := 0.0;
                                #trajectory.profiles[#ax].brake.p[1] := 0.0;
                                #trajectory.profiles[#ax].brake.p[2] := 0.0;
                            END_FOR;
                            #trajectory.duration := #phaseDur;
                            #syncHandled := true;
                        END_IF;
                    END_IF;

                    // ---- Unified per-axis flow (No / Time / TimeIfNecessary) ---
                    IF NOT #syncHandled THEN
                        // 1. resolve effective mode + participation per axis
                        FOR #ax := 0 TO #nd - 1 DO
                            IF #input.perDofSynchronization[#ax] >= 0 THEN
                                #modeEff[#ax] := #input.perDofSynchronization[#ax];
                            ELSE
                                #modeEff[#ax] := #input.synchronization;
                            END_IF;
                            IF #modeEff[#ax] = "dbRuckigConst".SYNC_PHASE THEN
                                #modeEff[#ax] := "dbRuckigConst".SYNC_TIME;
                            END_IF;
                            #participates[#ax] := #modeEff[#ax] <> "dbRuckigConst".SYNC_NONE;
                        END_FOR;

                        // 2. Brake each axis (out-of-limit v0/a0), Block from the
                        //    post-brake state, then fold the brake duration into the
                        //    Block so Synchronize works in total-duration space
                        //    (Ruckig block.hpp: t_min = t_sum + brake.duration).
                        FOR #ax := 0 TO #nd - 1 DO
                            // ComputeBrakeProfile writes profile.brake (integrated
                            // prefix) and the post-brake state into brake.p[2]
                            // (relative position advance), brake.v[2], brake.a[2].
                            // It clears the brake and returns 0 when already in limits.
                            // Do NOT bind its => outputs (transpiler quirk #6); read
                            // the post-brake state from profile.brake.[2].
                            #brakeDur[#ax] := "ComputeBrakeProfile"(
                                profile := #trajectory.profiles[#ax],
                                v0 := #chainVel[#ax],
                                a0 := #chainAcc[#ax],
                                vMax := #input.maxVelocity[#ax],
                                aMax := #input.maxAcceleration[#ax],
                                jMax := #input.maxJerk[#ax]);
                            #mainP0 := #chainPos[#ax] + #trajectory.profiles[#ax].brake.p[2];
                            #mainV0 := #trajectory.profiles[#ax].brake.v[2];
                            #mainA0 := #trajectory.profiles[#ax].brake.a[2];

                            #blockResult := "ComputeBlock1Axis"(
                                block := #blockSet.items[#ax],
                                profile := #trajectory.profiles[#ax],
                                p0 := #mainP0, v0 := #mainV0, a0 := #mainA0,
                                pT := #input.targetPosition[#ax],
                                vT := #input.targetVelocity[#ax],
                                aT := #input.targetAcceleration[#ax],
                                vMax := #input.maxVelocity[#ax],
                                aMax := #input.maxAcceleration[#ax],
                                jMax := #input.maxJerk[#ax]);
                            IF #blockResult <> "dbRuckigConst".RESULT_WORKING THEN
                                #valid := false;
                                #busy := false;
                                #done := false;
                                #error := true;
                                #status := "dbRuckigConst".RESULT_ERR_TRAJ;
                                #trajectory.isValid := false;
                                RETURN;
                            END_IF;

                            // fold the brake into the Block (total-duration space)
                            #blockSet.items[#ax].tMin := #blockSet.items[#ax].tMin + #brakeDur[#ax];
                            IF #blockSet.items[#ax].aValid THEN
                                #blockSet.items[#ax].aLeft := #blockSet.items[#ax].aLeft + #brakeDur[#ax];
                                #blockSet.items[#ax].aRight := #blockSet.items[#ax].aRight + #brakeDur[#ax];
                            END_IF;
                            IF #blockSet.items[#ax].bValid THEN
                                #blockSet.items[#ax].bLeft := #blockSet.items[#ax].bLeft + #brakeDur[#ax];
                                #blockSet.items[#ax].bRight := #blockSet.items[#ax].bRight + #brakeDur[#ax];
                            END_IF;
                        END_FOR;

                        // 3. t_sync over participating axes (+ discrete)
                        #isDiscrete := #input.durationDiscretization = "dbRuckigConst".DISC_DISCRETE;
                        "Synchronize"(
                            blockSet := #blockSet,
                            nDofs := #nd,
                            minimumDuration := #input.minimumDuration,
                            participates := #participates,
                            discrete := #isDiscrete,
                            cycleTime := #cycleTime,
                            resolved => #syncOk,
                            tSync => #tSync,
                            limitingAxis => #limitingAxis);
                        IF NOT #syncOk THEN
                            #valid := false;
                            #busy := false;
                            #done := false;
                            #error := true;
                            #status := "dbRuckigConst".RESULT_ERR_SYNC;
                            #trajectory.isValid := false;
                            RETURN;
                        END_IF;

                        // 4. emit per axis
                        //    profile.brake already populated/cleared by ComputeBrakeProfile
                        //    in the Block loop above; do NOT zero-fill it here.
                        #mainDuration := 0.0;
                        FOR #ax := 0 TO #nd - 1 DO
                            #tinMoving := #modeEff[#ax] = "dbRuckigConst".SYNC_TIME;
                            IF #modeEff[#ax] = "dbRuckigConst".SYNC_TIME_IF_NECESSARY THEN
                                IF ABS(#input.targetVelocity[#ax]) > "dbRuckigConst".EPS_VELOCITY
                                    OR ABS(#input.targetAcceleration[#ax]) > "dbRuckigConst".EPS_DERIV THEN
                                    #tinMoving := true;
                                END_IF;
                            END_IF;

                            // at-target and stationary: zero-fill; avoids a degenerate solve
                            // (axes cruising through their target, v0=vT!=0, must NOT be zero-filled)
                            #atTarget :=
                                ABS(#input.targetPosition[#ax] - #chainPos[#ax]) < "dbRuckigConst".EPS_POSITION
                                AND ABS(#input.targetVelocity[#ax] - #chainVel[#ax]) < "dbRuckigConst".EPS_VELOCITY
                                AND ABS(#input.targetAcceleration[#ax] - #chainAcc[#ax]) < "dbRuckigConst".EPS_DERIV
                                AND ABS(#chainVel[#ax]) < "dbRuckigConst".EPS_VELOCITY
                                AND ABS(#chainAcc[#ax]) < "dbRuckigConst".EPS_DERIV;

                            IF #atTarget THEN
                                FOR #i := 0 TO 6 DO
                                    #trajectory.profiles[#ax].t[#i] := 0.0;
                                    #trajectory.profiles[#ax].j[#i] := 0.0;
                                END_FOR;
                                FOR #i := 0 TO 7 DO
                                    #trajectory.profiles[#ax].a[#i] := #chainAcc[#ax];
                                    #trajectory.profiles[#ax].v[#i] := #chainVel[#ax];
                                    #trajectory.profiles[#ax].p[#i] := #chainPos[#ax];
                                END_FOR;
                            ELSIF #tinMoving THEN
                                #mainP0 := #chainPos[#ax] + #trajectory.profiles[#ax].brake.p[2];
                                #mainV0 := #trajectory.profiles[#ax].brake.v[2];
                                #mainA0 := #trajectory.profiles[#ax].brake.a[2];
                                #profileResult := "ComputeProfile1AxisTimed"(
                                    profile := #trajectory.profiles[#ax],
                                    p0 := #mainP0, v0 := #mainV0, a0 := #mainA0,
                                    pT := #input.targetPosition[#ax], vT := #input.targetVelocity[#ax],
                                    aT := #input.targetAcceleration[#ax],
                                    vMax := #input.maxVelocity[#ax], aMax := #input.maxAcceleration[#ax],
                                    jMax := #input.maxJerk[#ax], tf := #tSync - #brakeDur[#ax]);
                                IF #profileResult <> "dbRuckigConst".RESULT_WORKING AND #profileResult <> "dbRuckigConst".RESULT_FINISHED THEN
                                    #valid := false;
                                    #busy := false;
                                    #done := false;
                                    #error := true;
                                    #status := "dbRuckigConst".RESULT_ERR_TRAJ;
                                    #trajectory.isValid := false;
                                    RETURN;
                                END_IF;
                            ELSE
                                #mainP0 := #chainPos[#ax] + #trajectory.profiles[#ax].brake.p[2];
                                #mainV0 := #trajectory.profiles[#ax].brake.v[2];
                                #mainA0 := #trajectory.profiles[#ax].brake.a[2];
                                #profileResult := "ComputeProfile1Axis"(profile := #trajectory.profiles[#ax],
                                    p0 := #mainP0, v0 := #mainV0, a0 := #mainA0,
                                    pT := #input.targetPosition[#ax], vT := #input.targetVelocity[#ax],
                                    aT := #input.targetAcceleration[#ax],
                                    vMax := #input.maxVelocity[#ax], aMax := #input.maxAcceleration[#ax],
                                    jMax := #input.maxJerk[#ax]);
                                IF #profileResult <> "dbRuckigConst".RESULT_WORKING AND #profileResult <> "dbRuckigConst".RESULT_FINISHED THEN
                                    #valid := false;
                                    #busy := false;
                                    #done := false;
                                    #error := true;
                                    #status := "dbRuckigConst".RESULT_ERR_TRAJ;
                                    #trajectory.isValid := false;
                                    RETURN;
                                END_IF;
                            END_IF;

                            #axDur := #brakeDur[#ax];
                            FOR #i := 0 TO 6 DO
                                #axDur := #axDur + #trajectory.profiles[#ax].t[#i];
                            END_FOR;
                            // tMin already includes brakeDur[ax] (folded in the Block loop above)
                            IF #participates[#ax] THEN
                                #trajectory.independentMinDurations[#ax] := #blockSet.items[#ax].tMin;
                            ELSE
                                #trajectory.independentMinDurations[#ax] := #axDur;
                            END_IF;
                            IF #axDur > #mainDuration THEN
                                #mainDuration := #axDur;
                            END_IF;
                        END_FOR;
                        #trajectory.duration := #mainDuration;
                        #syncHandled := true;
                    END_IF;
                END_IF;
                // END_IF for controlInterface = 1 (velocity) ELSE (position)
                END_IF;

                #trajectory.currentTime := 0.0;
                #trajectory.isValid := true;
                #prevInput := #input;
                #firstCall := false;
            END_IF;
        END_REGION

        REGION Advance and evaluate (sample every DoF)
            "AdvanceTime"(trajectory := #trajectory, dt := #cycleTime);
            FOR #ax := 0 TO #nd - 1 DO
                "StateAtTime"(profile := #trajectory.profiles[#ax], t := #trajectory.currentTime, p => #op, v => #ov, a => #oa);
                #output.newPosition[#ax] := #op;
                #output.newVelocity[#ax] := #ov;
                #output.newAcceleration[#ax] := #oa;
            END_FOR;
            #output.trajectoryDuration := #trajectory.duration;
            #output.currentTime := #trajectory.currentTime;
        END_REGION

        REGION Status flags and code
            IF #trajectory.currentTime >= #trajectory.duration - "dbRuckigConst".EPS_TIME THEN
                #valid := true;
                #busy := false;
                #done := true;
                #error := false;
                #status := "dbRuckigConst".RESULT_FINISHED;
                #output.workingOutput := false;
            ELSE
                #valid := true;
                #busy := true;
                #done := false;
                #error := false;
                #status := "dbRuckigConst".RESULT_WORKING;
                #output.workingOutput := true;
            END_IF;
        END_REGION

        REGION Chain update - pass_to_input (end of cycle, all DoFs)
            FOR #ax := 0 TO #nd - 1 DO
                #chainPos[#ax] := #output.newPosition[#ax];
                #chainVel[#ax] := #output.newVelocity[#ax];
                #chainAcc[#ax] := #output.newAcceleration[#ax];
            END_FOR;
        END_REGION
    END_NETWORK
END_FUNCTION_BLOCK
