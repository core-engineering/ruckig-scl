{
    S7_Author := "Martin C";
    S7_EditorMode := "SCL";
    S7_Family := "Ruckig";
    S7_Optimized := "TRUE";
    S7_Version := "0.3.0"
}
FUNCTION "CheckProfile" : Bool
    VAR_IN_OUT
        profile : _.typeProfile;
    END_VAR
    VAR_INPUT
        p0   : LReal;
        v0   : LReal;
        a0   : LReal;
        pT   : LReal;
        vT   : LReal;
        aT   : LReal;
        vMax : LReal;
        aMax : LReal;
        // step2 (v0.3): imposed total duration. Sentinel tf < 0 disables the
        // duration check (step1 / time-optimal callers pass tf := -1.0).
        tf   : LReal;
    END_VAR
    VAR_TEMP
        i       : DInt;
        vAtZero : LReal;
        denom   : LReal;
        sumT    : LReal;
    END_VAR
    VAR CONSTANT
        EPS_TIME   : LReal := 1.0E-9;
        EPS_LIMIT  : LReal := 1.0E-7;
        EPS_TARGET : LReal := 1.0E-6;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        REGION Block header
            //==========================================================
            // Title:      CheckProfile
            // Function:   Validate a candidate 7 phase profile: times,
            //             v/a limits, and reaching the target state.
            // Family:     Ruckig
            // Author:     Martin C
            //==========================================================
        END_REGION

        REGION Integrate states from initial condition
            "IntegrateProfileStates"(profile := #profile, p0 := #p0, v0 := #v0, a0 := #a0);
        END_REGION

        REGION Phase times non negative
            FOR #i := 0 TO 6 DO
                IF #profile.t[#i] < -#EPS_TIME THEN
                    #CheckProfile := false;
                    RETURN;
                END_IF;
            END_FOR;
        END_REGION

        REGION Velocity and acceleration limits
            FOR #i := 0 TO 7 DO
                IF ABS(#profile.v[#i]) > #vMax + #EPS_LIMIT THEN
                    #CheckProfile := false;
                    RETURN;
                END_IF;
                IF ABS(#profile.a[#i]) > #aMax + #EPS_LIMIT THEN
                    #CheckProfile := false;
                    RETURN;
                END_IF;
            END_FOR;
        END_REGION

        REGION Internal velocity extrema
            // Node samples miss velocity peaks that occur WHEN the acceleration
            // crosses zero inside a phase. Port of Ruckig profile.hpp check<>
            // (lines 249-254): for i >= 2, if a[i] and a[i+1] have opposite
            // signs, velocity has an interior extremum
            //   v_a_zero = v[i] - a[i]^2 / (2*j[i])
            // which must stay within +/- vMax. Phases 0-1 are exempt (Ruckig:
            // the velocity limit may legitimately be broken at the very start
            // when the initial velocity and acceleration are both extreme).
            FOR #i := 2 TO 6 DO
                IF #profile.a[#i] * #profile.a[#i + 1] < 0.0 THEN
                    #denom := 2.0 * #profile.j[#i];
                    #vAtZero := #profile.v[#i] - #profile.a[#i] * #profile.a[#i] / #denom;
                    IF ABS(#vAtZero) > #vMax + #EPS_LIMIT THEN
                        #CheckProfile := false;
                        RETURN;
                    END_IF;
                END_IF;
            END_FOR;
        END_REGION

        REGION Reaches target state
            IF ABS(#profile.p[7] - #pT) > #EPS_TARGET THEN
                #CheckProfile := false;
                RETURN;
            END_IF;
            IF ABS(#profile.v[7] - #vT) > #EPS_TARGET THEN
                #CheckProfile := false;
                RETURN;
            END_IF;
            IF ABS(#profile.a[7] - #aT) > #EPS_TARGET THEN
                #CheckProfile := false;
                RETURN;
            END_IF;
        END_REGION

        REGION Imposed duration (step2)
            // step2 profiles must land on the imposed duration tf. Skipped for
            // step1 / time-optimal callers (sentinel tf < 0).
            IF #tf >= 0.0 THEN
                #sumT := 0.0;
                FOR #i := 0 TO 6 DO
                    #sumT := #sumT + #profile.t[#i];
                END_FOR;
                IF ABS(#sumT - #tf) > #EPS_TIME THEN
                    #CheckProfile := false;
                    RETURN;
                END_IF;
            END_IF;
        END_REGION

        #CheckProfile := true;
    END_NETWORK
END_FUNCTION
