{
    S7_Author := "Martin C";
    S7_EditorMode := "SCL";
    S7_Family := "Ruckig";
    S7_Optimized := "TRUE";
    S7_Version := "0.4.0"
}
FUNCTION "Synchronize" : Void
    VAR_IN_OUT
        blockSet : _.typeBlockSet;
    END_VAR
    VAR_INPUT
        nDofs           : Int;
        minimumDuration : LReal;   // sentinel < 0 = none
    END_VAR
    VAR_OUTPUT
        resolved     : Bool;   // TRUE if a t_sync was found
        tSync        : LReal;
        limitingAxis : Int;
    END_VAR
    VAR_TEMP
        tStart     : LReal;
        cand       : Array[0..12] of LReal;
        nc         : Int;
        d          : Int;
        i          : Int;
        k          : Int;
        tmp        : LReal;
        c          : LReal;
        blocked    : Bool;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        REGION Block header
            //==========================================================
            // Title:      Synchronize
            // Function:   Time synchronization across DoFs. Given each DoF's
            //             reachable-duration Block, find t_sync = smallest
            //             common duration >= max(tMin) that is not blocked for
            //             any DoF, and the limiting (slowest) DoF. Port of
            //             Ruckig TargetCalculator::synchronize (Time mode,
            //             calculator_target.hpp l.123-203).
            // Returns:    resolved = TRUE if a t_sync was found (VAR_OUTPUT, not
            //             a return value: the plc-code transpiler drops "=>"
            //             outputs when a function's return value is consumed).
            // Family:     Ruckig
            // Author:     Martin C
            //==========================================================
        END_REGION

        REGION Lower bound: max(tMin) and minimumDuration, limiting DoF
            #tStart := 0.0;
            IF #minimumDuration >= 0.0 THEN
                #tStart := #minimumDuration;
            END_IF;
            #limitingAxis := 0;
            FOR #d := 0 TO #nDofs - 1 DO
                IF #blockSet.items[#d].tMin > #tStart THEN
                    #tStart := #blockSet.items[#d].tMin;
                END_IF;
            END_FOR;
            // limiting DoF = the slowest (largest tMin)
            #tmp := -1.0;
            FOR #d := 0 TO #nDofs - 1 DO
                IF #blockSet.items[#d].tMin > #tmp THEN
                    #tmp := #blockSet.items[#d].tMin;
                    #limitingAxis := #d;
                END_IF;
            END_FOR;
        END_REGION

        REGION Collect candidate sync times (>= tStart)
            #nc := 0;
            #cand[#nc] := #tStart;
            #nc := #nc + 1;
            FOR #d := 0 TO #nDofs - 1 DO
                IF #blockSet.items[#d].aValid AND #blockSet.items[#d].aRight > #tStart THEN
                    #cand[#nc] := #blockSet.items[#d].aRight;
                    #nc := #nc + 1;
                END_IF;
                IF #blockSet.items[#d].bValid AND #blockSet.items[#d].bRight > #tStart THEN
                    #cand[#nc] := #blockSet.items[#d].bRight;
                    #nc := #nc + 1;
                END_IF;
            END_FOR;
        END_REGION

        REGION Sort candidates ascending
            FOR #i := 0 TO #nc - 2 DO
                FOR #k := 0 TO #nc - 2 - #i DO
                    IF #cand[#k] > #cand[#k + 1] THEN
                        #tmp := #cand[#k];
                        #cand[#k] := #cand[#k + 1];
                        #cand[#k + 1] := #tmp;
                    END_IF;
                END_FOR;
            END_FOR;
        END_REGION

        REGION Pick smallest non-blocked candidate
            #resolved := false;
            #tSync := #tStart;
            FOR #i := 0 TO #nc - 1 DO
                IF NOT #resolved THEN
                    #c := #cand[#i];
                    #blocked := false;
                    FOR #d := 0 TO #nDofs - 1 DO
                        IF #blockSet.items[#d].aValid AND #blockSet.items[#d].aLeft < #c AND #c < #blockSet.items[#d].aRight THEN
                            #blocked := true;
                        END_IF;
                        IF #blockSet.items[#d].bValid AND #blockSet.items[#d].bLeft < #c AND #c < #blockSet.items[#d].bRight THEN
                            #blocked := true;
                        END_IF;
                    END_FOR;
                    IF NOT #blocked THEN
                        #tSync := #c;
                        #resolved := true;
                    END_IF;
                END_IF;
            END_FOR;
        END_REGION
    END_NETWORK
END_FUNCTION
