{
    S7_Author := "Martin C";
    S7_EditorMode := "SCL";
    S7_Family := "Ruckig";
    S7_Optimized := "TRUE";
    S7_Version := "0.1.0"
}
FUNCTION "ComputeFinalProfile" : Word
    VAR_IN_OUT
        profile : _.typeProfile;
    END_VAR
    VAR_INPUT
        duration : LReal;
        p0       : LReal;
        p1       : LReal;
        vMax     : LReal;
        aMax     : LReal;
        jMax     : LReal;
    END_VAR
    VAR_TEMP
        delta     : LReal;
        absDelta  : LReal;
        direction : Int;
        tJerk     : LReal;
        tAcc      : LReal;
        tVel      : LReal;
        sToVmax   : LReal;
        vPeak     : LReal;
        jSign     : LReal;
        i         : DInt;
        dt        : LReal;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        REGION Block header
            //==========================================================
            // Title:      ComputeFinalProfile
            // Function:   Fill the 7 phase profile structure from
            //             a rest to rest displacement
            // Family:     Ruckig
            // Author:     Martin C
            //==========================================================
        END_REGION

        REGION Initialise direction
            #delta := #p1 - #p0;
            #absDelta := ABS(#delta);
            IF #delta < 0.0 THEN
                #direction := -1;
            ELSE
                #direction := 1;
            END_IF;
            #profile.direction := #direction;
        END_REGION

        REGION Clear brake pre-profile
            // No brake for a rest-to-rest move. Explicit zero-init so a
            // downstream StateAtTime reads defined LReals (on the PLC these
            // default to 0.0; the test executor needs them written).
            #profile.brake.t[0] := 0.0;
            #profile.brake.t[1] := 0.0;
            #profile.brake.j[0] := 0.0;
            #profile.brake.j[1] := 0.0;
            #profile.brake.a[0] := 0.0;
            #profile.brake.a[1] := 0.0;
            #profile.brake.a[2] := 0.0;
            #profile.brake.v[0] := 0.0;
            #profile.brake.v[1] := 0.0;
            #profile.brake.v[2] := 0.0;
            #profile.brake.p[0] := 0.0;
            #profile.brake.p[1] := 0.0;
            #profile.brake.p[2] := 0.0;
        END_REGION

        REGION Trivial case zero displacement
            IF #absDelta < "dbRuckigConst".EPS_POSITION THEN
                FOR #i := 0 TO 6 DO
                    #profile.t[#i] := 0.0;
                    #profile.j[#i] := 0.0;
                END_FOR;
                FOR #i := 0 TO 7 DO
                    #profile.a[#i] := 0.0;
                    #profile.v[#i] := 0.0;
                    #profile.p[#i] := #p0;
                END_FOR;
                #ComputeFinalProfile := "dbRuckigConst".RESULT_FINISHED;
                RETURN;
            END_IF;
        END_REGION

        REGION Compute phase durations
            #tJerk := #aMax / #jMax;
            #tAcc  := #vMax / #aMax - #tJerk;
            IF #tAcc < 0.0 THEN
                #tJerk := SQRT(#vMax / #jMax);
                #tAcc  := 0.0;
            END_IF;
            #sToVmax := #vMax * (2.0 * #tJerk + #tAcc);

            IF #absDelta >= #sToVmax THEN
                // Case A: full trapezoidal (v_max reached)
                #tVel := (#absDelta - #sToVmax) / #vMax;
            ELSE
                // v_max not reached. Try triangular (B).
                #tJerk := EXP(LN(#absDelta / (2.0 * #jMax)) / 3.0);
                IF #jMax * #tJerk <= #aMax + "dbRuckigConst".EPS_DERIV THEN
                    // Case B: triangular (no a_max either)
                    #tAcc := 0.0;
                    #tVel := 0.0;
                ELSE
                    // Case C: a_max reached but v_max not
                    #tJerk := #aMax / #jMax;
                    #vPeak := (-#aMax * #tJerk
                              + SQRT(#aMax * #tJerk * #aMax * #tJerk + 4.0 * #aMax * #absDelta)) / 2.0;
                    #tAcc := #vPeak / #aMax - #tJerk;
                    #tVel := 0.0;
                END_IF;
            END_IF;
        END_REGION

        REGION Set 7 phase durations and jerks
            IF #direction > 0 THEN
                #jSign := #jMax;
            ELSE
                #jSign := -#jMax;
            END_IF;
            #profile.t[0] := #tJerk;
            #profile.j[0] :=  #jSign;
            #profile.t[1] := #tAcc;
            #profile.j[1] :=  0.0;
            #profile.t[2] := #tJerk;
            #profile.j[2] := -#jSign;
            #profile.t[3] := #tVel;
            #profile.j[3] :=  0.0;
            #profile.t[4] := #tJerk;
            #profile.j[4] := -#jSign;
            #profile.t[5] := #tAcc;
            #profile.j[5] :=  0.0;
            #profile.t[6] := #tJerk;
            #profile.j[6] :=  #jSign;
        END_REGION

        REGION Integrate boundary states from initial state
            #profile.p[0] := #p0;
            #profile.v[0] := 0.0;
            #profile.a[0] := 0.0;
            FOR #i := 0 TO 6 DO
                #dt := #profile.t[#i];
                #profile.a[#i + 1] := #profile.a[#i]
                                    + #profile.j[#i] * #dt;
                #profile.v[#i + 1] := #profile.v[#i]
                                    + #profile.a[#i] * #dt
                                    + 0.5 * #profile.j[#i] * #dt * #dt;
                #profile.p[#i + 1] := #profile.p[#i]
                                    + #profile.v[#i] * #dt
                                    + 0.5 * #profile.a[#i] * #dt * #dt
                                    + #profile.j[#i] * #dt * #dt * #dt / 6.0;
            END_FOR;
        END_REGION

        #ComputeFinalProfile := "dbRuckigConst".RESULT_WORKING;
    END_NETWORK
END_FUNCTION
