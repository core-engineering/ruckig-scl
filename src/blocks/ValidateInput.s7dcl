{
    S7_Author := "Martin C";
    S7_EditorMode := "SCL";
    S7_Family := "Ruckig";
    S7_Optimized := "TRUE";
    S7_Version := "0.1.0"
}
FUNCTION "ValidateInput" : Word
    VAR_IN_OUT
        input : _.typeRuckigInput;
    END_VAR
    VAR_TEMP
        i : DInt;
        v : LReal;
    END_VAR
    VAR CONSTANT
        DOF_MAX               : DInt := 4;
        INF_THRESHOLD         : LReal := 1.0E308;
        RESULT_WORKING        : Word := 16#7000;
        RESULT_ERR_VMAX       : Word := 16#8201;
        RESULT_ERR_AMAX       : Word := 16#8202;
        RESULT_ERR_JMAX       : Word := 16#8203;
        RESULT_ERR_CURR_VEL   : Word := 16#8204;
        RESULT_ERR_CURR_ACC   : Word := 16#8205;
        RESULT_ERR_NDOFS      : Word := 16#8206;
        RESULT_ERR_NON_FINITE : Word := 16#8207;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        REGION Block header
            //==========================================================
            // Title:      ValidateInput
            // Function:   Validate Ruckig input parameters
            // Returns:    RESULT_WORKING if OK, RESULT_ERR_* otherwise
            // Family:     Ruckig
            // Author:     Martin C
            //==========================================================
        END_REGION

        REGION nDofs bounds check
            IF #input.nDofs < 1 OR #input.nDofs > #DOF_MAX THEN
                #ValidateInput := #RESULT_ERR_NDOFS;
                RETURN;
            END_IF;
        END_REGION

        REGION Per axis validation
            FOR #i := 0 TO #input.nDofs - 1 DO
                // Finite value checks inlined (avoid inter-FC call)
                #v := #input.currentPosition[#i];
                IF #v <> #v OR ABS(#v) > #INF_THRESHOLD THEN
                    #ValidateInput := #RESULT_ERR_NON_FINITE;
                    RETURN;
                END_IF;
                #v := #input.currentVelocity[#i];
                IF #v <> #v OR ABS(#v) > #INF_THRESHOLD THEN
                    #ValidateInput := #RESULT_ERR_NON_FINITE;
                    RETURN;
                END_IF;
                #v := #input.currentAcceleration[#i];
                IF #v <> #v OR ABS(#v) > #INF_THRESHOLD THEN
                    #ValidateInput := #RESULT_ERR_NON_FINITE;
                    RETURN;
                END_IF;
                #v := #input.targetPosition[#i];
                IF #v <> #v OR ABS(#v) > #INF_THRESHOLD THEN
                    #ValidateInput := #RESULT_ERR_NON_FINITE;
                    RETURN;
                END_IF;
                #v := #input.targetVelocity[#i];
                IF #v <> #v OR ABS(#v) > #INF_THRESHOLD THEN
                    #ValidateInput := #RESULT_ERR_NON_FINITE;
                    RETURN;
                END_IF;
                #v := #input.targetAcceleration[#i];
                IF #v <> #v OR ABS(#v) > #INF_THRESHOLD THEN
                    #ValidateInput := #RESULT_ERR_NON_FINITE;
                    RETURN;
                END_IF;

                // Positive limit checks
                IF #input.maxVelocity[#i] <= 0.0 THEN
                    #ValidateInput := #RESULT_ERR_VMAX;
                    RETURN;
                END_IF;
                IF #input.maxAcceleration[#i] <= 0.0 THEN
                    #ValidateInput := #RESULT_ERR_AMAX;
                    RETURN;
                END_IF;
                IF #input.maxJerk[#i] <= 0.0 THEN
                    #ValidateInput := #RESULT_ERR_JMAX;
                    RETURN;
                END_IF;

                // Current state consistency
                IF ABS(#input.currentVelocity[#i]) > #input.maxVelocity[#i] THEN
                    #ValidateInput := #RESULT_ERR_CURR_VEL;
                    RETURN;
                END_IF;
                IF ABS(#input.currentAcceleration[#i]) > #input.maxAcceleration[#i] THEN
                    #ValidateInput := #RESULT_ERR_CURR_ACC;
                    RETURN;
                END_IF;
            END_FOR;
        END_REGION

        // All checks passed
        #ValidateInput := #RESULT_WORKING;
    END_NETWORK
END_FUNCTION
