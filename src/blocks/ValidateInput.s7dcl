{
    S7_Author := "Martin C";
    S7_EditorMode := "SCL";
    S7_Family := "Ruckig";
    S7_Optimized := "TRUE";
    S7_Version := "0.7.0"
}
FUNCTION "ValidateInput" : Word
    VAR_IN_OUT
        input : _.typeRuckigInput;
    END_VAR
    VAR_TEMP
        i : DInt;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        REGION Block header
            //==========================================================
            // Title:      ValidateInput
            // Function:   Validate Ruckig input parameters
            // Returns:    RESULT_WORKING if OK, RESULT_ERR_* otherwise
            // Family:     Ruckig
            // Author:     Martin C
            //==========================================================
        END_REGION

        REGION nDofs bounds check
            IF #input.nDofs < 1 OR #input.nDofs > "dbRuckigConst".DOF_MAX THEN
                #ValidateInput := "dbRuckigConst".RESULT_ERR_NDOFS;
                RETURN;
            END_IF;
        END_REGION

        REGION controlInterface range check
            // IFACE_POSITION=0, IFACE_VELOCITY=1; reject anything outside {0,1}.
            // Note: "dbRuckigConst".IFACE_* constants cannot be used here due to a
            // transpiler quirk (identifier starting with "IF" is mis-tokenised as
            // the IF keyword).  Literal values are equivalent in both SCL and the
            // test bench, and the constants remain the authoritative definition in
            // dbRuckigConst.
            IF #input.controlInterface <> 0 AND #input.controlInterface <> 1 THEN
                #ValidateInput := "dbRuckigConst".RESULT_ERR_IFACE;
                RETURN;
            END_IF;
        END_REGION

        REGION Per-axis validation
            FOR #i := 0 TO #input.nDofs - 1 DO
                // Finiteness: currentPosition is the integration origin in both
                // interfaces; targetPosition is only used (and only required
                // finite) in the position interface (controlInterface = 0).
                IF NOT "IsFiniteLreal"(x := #input.currentPosition[#i]) THEN
                    #ValidateInput := "dbRuckigConst".RESULT_ERR_NON_FINITE;
                    RETURN;
                END_IF;
                IF NOT "IsFiniteLreal"(x := #input.currentVelocity[#i]) THEN
                    #ValidateInput := "dbRuckigConst".RESULT_ERR_NON_FINITE;
                    RETURN;
                END_IF;
                IF NOT "IsFiniteLreal"(x := #input.currentAcceleration[#i]) THEN
                    #ValidateInput := "dbRuckigConst".RESULT_ERR_NON_FINITE;
                    RETURN;
                END_IF;
                IF #input.controlInterface = 0 THEN
                    IF NOT "IsFiniteLreal"(x := #input.targetPosition[#i]) THEN
                        #ValidateInput := "dbRuckigConst".RESULT_ERR_NON_FINITE;
                        RETURN;
                    END_IF;
                END_IF;
                IF NOT "IsFiniteLreal"(x := #input.targetVelocity[#i]) THEN
                    #ValidateInput := "dbRuckigConst".RESULT_ERR_NON_FINITE;
                    RETURN;
                END_IF;
                IF NOT "IsFiniteLreal"(x := #input.targetAcceleration[#i]) THEN
                    #ValidateInput := "dbRuckigConst".RESULT_ERR_NON_FINITE;
                    RETURN;
                END_IF;

                // Positive limits: vMax is a constraint only in the position
                // interface (controlInterface = 0); the velocity interface
                // ignores it (Ruckig parity).
                IF #input.controlInterface = 0 THEN
                    IF #input.maxVelocity[#i] <= 0.0 THEN
                        #ValidateInput := "dbRuckigConst".RESULT_ERR_VMAX;
                        RETURN;
                    END_IF;
                END_IF;
                IF #input.maxAcceleration[#i] <= 0.0 THEN
                    #ValidateInput := "dbRuckigConst".RESULT_ERR_AMAX;
                    RETURN;
                END_IF;
                IF #input.maxJerk[#i] <= 0.0 THEN
                    #ValidateInput := "dbRuckigConst".RESULT_ERR_JMAX;
                    RETURN;
                END_IF;

                // NOTE: the current state (velocity/acceleration) is deliberately
                // NOT required to be within limits (Ruckig validate() default).
            END_FOR;
        END_REGION

        // All checks passed
        #ValidateInput := "dbRuckigConst".RESULT_WORKING;
    END_NETWORK
END_FUNCTION
