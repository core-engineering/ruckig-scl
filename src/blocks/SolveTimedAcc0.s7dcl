FUNCTION "SolveTimedAcc0" : Void
    VAR_IN_OUT
        profile : _.typeProfile;
        found   : Bool;
    END_VAR
    VAR_INPUT
        p0    : LReal;
        v0    : LReal;
        a0    : LReal;
        pT    : LReal;
        vT    : LReal;
        aT    : LReal;
        svMax : LReal;
        svMin : LReal;
        saMax : LReal;
        saMin : LReal;
        sjMax : LReal;
        tf    : LReal;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        REGION Stub - implemented in a later v0.3 task
            // step2 family time_Acc0 (re-time to tf). Ruckig
            // position_third_step2.cpp. First-valid-wins: skip if already found.
            // TODO(v0.3): port the UDDU[/UDUD] closed-form / quartic candidates,
            // set profile.t/j, validate with "CheckProfile"(... tf := #tf), and
            // set #found := true on success.
            IF #found THEN
                RETURN;
            END_IF;
        END_REGION
    END_NETWORK
END_FUNCTION
