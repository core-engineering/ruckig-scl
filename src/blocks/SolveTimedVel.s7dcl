{
    S7_Author := "Martin C";
    S7_EditorMode := "SCL";
    S7_Family := "Ruckig";
    S7_Optimized := "TRUE";
    S7_Version := "0.10.0"
}
FUNCTION "SolveTimedVel" : Void
    VAR_IN_OUT
        profile : _.typeProfile;
        found   : Bool;
    END_VAR
    VAR_INPUT
        p0    : LReal;
        v0    : LReal;
        a0    : LReal;
        pT    : LReal;
        vT    : LReal;
        aT    : LReal;
        svMax : LReal;
        svMin : LReal;
        saMax : LReal;
        saMin : LReal;
        sjMax : LReal;
        tf    : LReal;
    END_VAR
    VAR_TEMP
        vMaxMag : LReal;
        aMaxMag : LReal;
        pd        : LReal;
        vd        : LReal;
        vd_vd     : LReal;
        ad        : LReal;
        a0_a0     : LReal;
        af_af     : LReal;
        a0_p3     : LReal;
        a0_p4     : LReal;
        a0_p5     : LReal;
        a0_p6     : LReal;
        af_p3     : LReal;
        af_p4     : LReal;
        af_p6     : LReal;
        jMax_jMax : LReal;
        tf_tf     : LReal;
        g1        : LReal;
        // poly + helpers
        p1    : LReal;
        ph1   : LReal;
        ph2   : LReal;
        ph3   : LReal;
        ph5   : LReal;
        den_2jj : LReal;
        den_6jj : LReal;
        den_p6  : LReal;
        ph4   : LReal;
        poly  : Array[0..6] of LReal;
        den_p1 : LReal;
        den_p2 : LReal;
        den_p3 : LReal;
        den_p4 : LReal;
        den_p5 : LReal;
        den_12jj : LReal;
        // derivative-extrema seeding (Attempt C)
        derivArr  : Array[0..6] of LReal;  // monic derivative of poly
        dderivArr : Array[0..6] of LReal;  // standard/monic derivative of derivArr
        ddderivArr : Array[0..6] of LReal; // standard derivative of dderivArr (UDUD)
        qRoots : Array[0..3] of LReal;
        qCount : Int;
        qr     : Int;
        tzCur  : LReal;
        ddTzCur : LReal;
        derivVal   : LReal;
        ddVal      : LReal;
        polyValNew : LReal;
        polyValCur : LReal;
        derivAtCur : LReal;
        derivAtNew : LReal;
        derivZero  : LReal;
        tzExtr  : LReal;  // refined extremum (separate from root candidate #t)
        // sorting scratch
        sortTmp : LReal;
        si : Int;
        sj : Int;
        // window
        tzMin   : LReal;
        tzMax   : LReal;
        // check_root scratch
        t      : LReal;
        h1     : LReal;
        h1arg  : LReal;
        num    : LReal;
        orig   : LReal;
        derivN : LReal;
        ok     : Bool;
        // all-zero cubic branch
        cubB     : LReal;
        cubD     : LReal;
        cubRoots : Array[0..3] of LReal;
        cubCount : Int;
        cr       : Int;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        REGION Block header
            //==========================================================
            // Title:      SolveTimedVel
            // Function:   step2 family time_vel: re-time to tf a profile that
            //             reaches the velocity plateau but neither accel limit
            //             (VEL, t[1]=t[5]=0). Port of Ruckig
            //             position_third_step2.cpp l.259-488.
            //             General case: degree-5 (UDDU) / degree-6 (UDUD) poly.
            //             Real roots in [tz_min,tz_max] found by derivative-
            //             extrema seeding (Attempt C): compute monic derivative,
            //             solve SolveQuartic for extrema, walk extrema tracking
            //             tz_current for sign-change brackets, refine via
            //             ShrinkInterval, then check_root (Newton + CheckProfile).
            //             UDUD: 2-level — SolveQuartic on 2nd-derivative extrema,
            //             bracket 1st-deriv, ShrinkInterval on deriv, then poly.
            // Family:     Ruckig
            // Author:     Martin C
            //==========================================================
        END_REGION

        REGION Skip if already solved
            IF #found THEN
                RETURN;
            END_IF;
        END_REGION

        REGION Precompute
            #vMaxMag := ABS(#svMax);
            #aMaxMag := ABS(#saMax);
            #pd    := #pT - #p0;
            #vd    := #vT - #v0;
            #vd_vd := #vd * #vd;
            #ad    := #aT - #a0;
            #a0_a0 := #a0 * #a0;
            #af_af := #aT * #aT;
            #a0_p3 := #a0 * #a0_a0;
            #a0_p4 := #a0_a0 * #a0_a0;
            #a0_p5 := #a0_p3 * #a0_a0;
            #a0_p6 := #a0_p3 * #a0_p3;
            #af_p3 := #aT * #af_af;
            #af_p4 := #af_af * #af_af;
            #af_p6 := #af_p3 * #af_p3;
            #jMax_jMax := #sjMax * #sjMax;
            #tf_tf := #tf * #tf;
            #g1 := -#pd + #tf * #v0;
            #den_12jj := 12.0 * #jMax_jMax;
            #den_2jj := 2.0 * #jMax_jMax;
            #den_6jj := 6.0 * #jMax_jMax;
        END_REGION

        REGION All-zero boundary cubic (UDDU VEL exact)
            // Ruckig time_vel l.264-296: when v0,a0,vf,af all ~0, the velocity-
            // plateau ramp time solves an exact cubic [1, -tf/2, 0, pd/(2*jMax)].
            IF ABS(#v0) < 1.0E-12 AND ABS(#a0) < 1.0E-12 AND ABS(#vT) < 1.0E-12 AND ABS(#aT) < 1.0E-12 THEN
                #cubB := -#tf / 2.0;
                #cubD := #pd / (2.0 * #sjMax);
                "SolveCubic"(a := 1.0, b := #cubB, c := 0.0, d := #cubD,
                    roots => #cubRoots, count => #cubCount);
                FOR #cr := 0 TO #cubCount - 1 DO
                    IF NOT #found THEN
                        #t := #cubRoots[#cr];
                        IF #t <= #tf / 4.0 THEN
                            IF #t > 1.0E-12 THEN
                                #orig := -#pd + #sjMax * #t * #t * (#tf - 2.0 * #t);
                                #derivN := 2.0 * #sjMax * #t * (#tf - 3.0 * #t);
                                IF ABS(#derivN) > 1.0E-12 THEN
                                    #t := #t - #orig / #derivN;
                                END_IF;
                            END_IF;
                            #profile.j[0] := #sjMax;
                            #profile.j[1] := 0.0;
                            #profile.j[2] := -#sjMax;
                            #profile.j[3] := 0.0;
                            #profile.j[4] := -#sjMax;
                            #profile.j[5] := 0.0;
                            #profile.j[6] := #sjMax;
                            #profile.t[0] := #t;
                            #profile.t[1] := 0.0;
                            #profile.t[2] := #t;
                            #profile.t[3] := #tf - 4.0 * #t;
                            #profile.t[4] := #t;
                            #profile.t[5] := 0.0;
                            #profile.t[6] := #t;
                            IF #profile.t[3] >= 1.0E-9 THEN
                                IF "CheckProfile"(profile := #profile, p0 := #p0, v0 := #v0, a0 := #a0,
                                        pT := #pT, vT := #vT, aT := #aT, vMax := #vMaxMag, aMax := #aMaxMag, tf := #tf) THEN
                                    #profile.controlSigns := 0;
                                    #found := true;
                                END_IF;
                            END_IF;
                        END_IF;
                    END_IF;
                END_FOR;
            END_IF;
        END_REGION

        REGION UDDU degree-5 polynomial — derivative-extrema seeding
            #p1  := #af_af - 2.0 * #sjMax * (-2.0 * #aT * #tf + #sjMax * #tf_tf + 3.0 * #vd);
            #ph1 := #af_p3 - 3.0 * #jMax_jMax * #g1 - 3.0 * #aT * #sjMax * #vd;
            #ph2 := #af_p4 + 8.0 * #af_p3 * #sjMax * #tf + 12.0 * #sjMax * (3.0 * #sjMax * #vd_vd - #af_af * #vd + 2.0 * #aT * #sjMax * (#g1 - #tf * #vd) - 2.0 * #jMax_jMax * #tf * #g1);
            #ph3 := #a0 * (#aT - #sjMax * #tf);
            #ph4 := #sjMax * (-#ad + #sjMax * #tf);
            IF ABS(#ph4) > 1.0E-12 THEN
                #den_p1 := 4.0 * #ph4;
                #den_p2 := 6.0 * #sjMax * #ph4;
                #den_p3 := 24.0 * #jMax_jMax * #ph4;
                #den_p4 := 12.0 * #jMax_jMax * #sjMax * #ph4;
                #den_p5 := 144.0 * #jMax_jMax * #jMax_jMax * #ph4;
                // poly[0..5], 6 coefficients for degree-5 monic polynomial
                #poly[0] := 1.0;
                #poly[1] := (15.0 * #a0_a0 + #af_af + 4.0 * #aT * #sjMax * #tf - 16.0 * #ph3 - 2.0 * #sjMax * (#sjMax * #tf_tf + 3.0 * #vd)) / #den_p1;
                #poly[2] := (29.0 * #a0_p3 - 2.0 * #af_p3 - 33.0 * #a0 * #ph3 + 6.0 * #jMax_jMax * #g1 + 6.0 * #aT * #sjMax * #vd + 6.0 * #a0 * #p1) / #den_p2;
                #poly[3] := (61.0 * #a0_p4 - 76.0 * #a0_a0 * #ph3 - 16.0 * #a0 * #ph1 + 30.0 * #a0_a0 * #p1 + #ph2) / #den_p3;
                #poly[4] := (#a0 * (7.0 * #a0_p4 - 10.0 * #a0_a0 * #ph3 - 4.0 * #a0 * #ph1 + 6.0 * #a0_a0 * #p1 + #ph2)) / #den_p4;
                #poly[5] := (7.0 * #a0_p6 + #af_p6 - 12.0 * #a0_p4 * #ph3 + 48.0 * #af_p3 * #jMax_jMax * #g1 - 8.0 * #a0_p3 * #ph1 - 72.0 * #jMax_jMax * #sjMax * (#sjMax * #g1 * #g1 + #vd_vd * #vd + 2.0 * #aT * #g1 * #vd) - 6.0 * #af_p4 * #sjMax * #vd + 36.0 * #af_af * #jMax_jMax * #vd_vd + 9.0 * #a0_p4 * #p1 + 3.0 * #a0_a0 * #ph2) / #den_p5;

                // window for tz
                #tzMin := -#a0 / #sjMax;
                IF #tzMin < 0.0 THEN
                    #tzMin := 0.0;
                END_IF;
                #tzMax := (#tf - #a0 / #sjMax) / 2.0;
                #num := (#saMax - #a0) / #sjMax;
                IF #num < #tzMax THEN
                    #tzMax := #num;
                END_IF;

                IF #tzMax > #tzMin THEN
                    // Monic degree-4 derivative of degree-5 monic poly:
                    // poly5 = [1, c1, c2, c3, c4, c5]
                    // monic_deriv = [1, 4c1/5, 3c2/5, 2c3/5, c4/5]
                    #derivArr[0] := 1.0;
                    #derivArr[1] := 4.0 * #poly[1] / 5.0;
                    #derivArr[2] := 3.0 * #poly[2] / 5.0;
                    #derivArr[3] := 2.0 * #poly[3] / 5.0;
                    #derivArr[4] := #poly[4] / 5.0;
                    // Standard derivative of derivArr (degree-3):
                    // dderiv[i] = (4-i)*derivArr[i] for i=0..3
                    #dderivArr[0] := 4.0 * #derivArr[0];
                    #dderivArr[1] := 3.0 * #derivArr[1];
                    #dderivArr[2] := 2.0 * #derivArr[2];
                    #dderivArr[3] := 1.0 * #derivArr[3];

                    // Solve quartic for extrema of derivArr
                    // derivArr = x^4 + d1 x^3 + d2 x^2 + d3 x + d4
                    "SolveQuartic"(a := 1.0, b := #derivArr[1], c := #derivArr[2],
                                   d := #derivArr[3], e := #derivArr[4],
                                   roots => #qRoots, count => #qCount);

                    // Bubble-sort qRoots[0..qCount-1] ascending
                    FOR #si := 0 TO #qCount - 2 DO
                        FOR #sj := 0 TO #qCount - 2 - #si DO
                            IF #qRoots[#sj] > #qRoots[#sj + 1] THEN
                                #sortTmp := #qRoots[#sj];
                                #qRoots[#sj] := #qRoots[#sj + 1];
                                #qRoots[#sj + 1] := #sortTmp;
                            END_IF;
                        END_FOR;
                    END_FOR;

                    // Walk extrema tracking tz_current (oracle pattern)
                    #tzCur := #tzMin;
                    FOR #qr := 0 TO #qCount - 1 DO
                        IF NOT #found THEN
                            #tzExtr := #qRoots[#qr];
                            IF #tzExtr < #tzMax THEN
                                // Newton refine on derivArr
                                #derivVal := "PolyEval"(p := #derivArr, n := 5, x := #tzExtr);
                                #ddVal    := "PolyEval"(p := #dderivArr, n := 4, x := #tzExtr);
                                IF ABS(#derivVal) > 1.0E-14 AND ABS(#ddVal) > 2.220446049250313E-16 THEN
                                    #tzExtr := #tzExtr - #derivVal / #ddVal;
                                END_IF;
                                #polyValNew := "PolyEval"(p := #poly, n := 6, x := #tzExtr);
                                #polyValCur := "PolyEval"(p := #poly, n := 6, x := #tzCur);
                                // Re-evaluate dderiv at refined extremum for threshold
                                #ddVal := "PolyEval"(p := #dderivArr, n := 4, x := #tzExtr);
                                IF ABS(#polyValNew) < 64.0 * ABS(#ddVal) * 1.0E-14 THEN
                                    // Near-zero at extremum: check_root directly
                                    #t := #tzExtr;
                                    #h1arg := (#a0_a0 + #af_af) / (2.0 * #jMax_jMax) + (2.0 * #a0 * #t + #sjMax * #t * #t - #vd) / #sjMax;
                                    IF #h1arg >= 0.0 THEN
                                        #h1 := SQRT(#h1arg);
                                        #num := 2.0 * #a0_p3 + 4.0 * #af_p3
                                            + 24.0 * #a0 * #sjMax * #t * (#aT + #sjMax * (#h1 + #t - #tf))
                                            + 6.0 * #a0_a0 * (#aT + #sjMax * (2.0 * #t - #tf))
                                            + 6.0 * (#a0_a0 + #af_af) * #sjMax * #h1
                                            + 12.0 * #aT * #sjMax * (#sjMax * #t * #t - #vd)
                                            + 12.0 * #jMax_jMax * (#sjMax * #t * #t * (#h1 + #t - #tf) - #tf * #v0 - #h1 * #vd);
                                        #orig := -#pd - #num / #den_12jj;
                                        #derivN := -(#a0 + #sjMax * #t) * (3.0 * (#h1 + #t) - 2.0 * #tf + (#a0 + 2.0 * #aT) / #sjMax);
                                        IF ABS(#derivN) > 2.220446049250313E-16 THEN
                                            #t := #t - #orig / #derivN;
                                        END_IF;
                                    END_IF;
                                    IF #t <= #tf THEN
                                        #h1arg := (#a0_a0 + #af_af) / (2.0 * #jMax_jMax) + (#t * (2.0 * #a0 + #sjMax * #t) - #vd) / #sjMax;
                                        IF #h1arg >= 0.0 THEN
                                            #h1 := SQRT(#h1arg);
                                            #profile.t[0] := #t;
                                            #profile.t[1] := 0.0;
                                            #profile.t[2] := #t + #a0 / #sjMax;
                                            #profile.t[3] := #tf - 2.0 * (#t + #h1) - (#a0 + #aT) / #sjMax;
                                            #profile.t[4] := #h1;
                                            #profile.t[5] := 0.0;
                                            #profile.t[6] := #h1 + #aT / #sjMax;
                                            #profile.j[0] := #sjMax;
                                            #profile.j[1] := 0.0;
                                            #profile.j[2] := -#sjMax;
                                            #profile.j[3] := 0.0;
                                            #profile.j[4] := -#sjMax;
                                            #profile.j[5] := 0.0;
                                            #profile.j[6] := #sjMax;
                                            #profile.direction := 1;
                                            #profile.controlSigns := 0;
                                            IF #profile.t[3] >= 1.0E-9 THEN
                                                #ok := "CheckProfile"(profile := #profile, p0 := #p0, v0 := #v0, a0 := #a0,
                                                    pT := #pT, vT := #vT, aT := #aT, vMax := #vMaxMag, aMax := #aMaxMag, tf := #tf);
                                                IF #ok THEN
                                                    #found := true;
                                                END_IF;
                                            END_IF;
                                        END_IF;
                                    END_IF;
                                ELSIF #polyValCur * #polyValNew < 0.0 THEN
                                    // Sign change between tzCur and tzExtr: bracket and shrink
                                    #t := "ShrinkInterval"(p := #poly, n := 6, l := #tzCur, h := #tzExtr);
                                    // check_root (UDDU) ----
                                    #h1arg := (#a0_a0 + #af_af) / (2.0 * #jMax_jMax) + (2.0 * #a0 * #t + #sjMax * #t * #t - #vd) / #sjMax;
                                    IF #h1arg >= 0.0 THEN
                                        #h1 := SQRT(#h1arg);
                                        #num := 2.0 * #a0_p3 + 4.0 * #af_p3
                                            + 24.0 * #a0 * #sjMax * #t * (#aT + #sjMax * (#h1 + #t - #tf))
                                            + 6.0 * #a0_a0 * (#aT + #sjMax * (2.0 * #t - #tf))
                                            + 6.0 * (#a0_a0 + #af_af) * #sjMax * #h1
                                            + 12.0 * #aT * #sjMax * (#sjMax * #t * #t - #vd)
                                            + 12.0 * #jMax_jMax * (#sjMax * #t * #t * (#h1 + #t - #tf) - #tf * #v0 - #h1 * #vd);
                                        #orig := -#pd - #num / #den_12jj;
                                        #derivN := -(#a0 + #sjMax * #t) * (3.0 * (#h1 + #t) - 2.0 * #tf + (#a0 + 2.0 * #aT) / #sjMax);
                                        IF ABS(#derivN) > 2.220446049250313E-16 THEN
                                            #t := #t - #orig / #derivN;
                                        END_IF;
                                    END_IF;
                                    IF #t <= #tf THEN
                                        #h1arg := (#a0_a0 + #af_af) / (2.0 * #jMax_jMax) + (#t * (2.0 * #a0 + #sjMax * #t) - #vd) / #sjMax;
                                        IF #h1arg >= 0.0 THEN
                                            #h1 := SQRT(#h1arg);
                                            #profile.t[0] := #t;
                                            #profile.t[1] := 0.0;
                                            #profile.t[2] := #t + #a0 / #sjMax;
                                            #profile.t[3] := #tf - 2.0 * (#t + #h1) - (#a0 + #aT) / #sjMax;
                                            #profile.t[4] := #h1;
                                            #profile.t[5] := 0.0;
                                            #profile.t[6] := #h1 + #aT / #sjMax;
                                            #profile.j[0] := #sjMax;
                                            #profile.j[1] := 0.0;
                                            #profile.j[2] := -#sjMax;
                                            #profile.j[3] := 0.0;
                                            #profile.j[4] := -#sjMax;
                                            #profile.j[5] := 0.0;
                                            #profile.j[6] := #sjMax;
                                            #profile.direction := 1;
                                            #profile.controlSigns := 0;
                                            IF #profile.t[3] >= 1.0E-9 THEN
                                                #ok := "CheckProfile"(profile := #profile, p0 := #p0, v0 := #v0, a0 := #a0,
                                                    pT := #pT, vT := #vT, aT := #aT, vMax := #vMaxMag, aMax := #aMaxMag, tf := #tf);
                                                IF #ok THEN
                                                    #found := true;
                                                END_IF;
                                            END_IF;
                                        END_IF;
                                    END_IF;
                                END_IF;
                                // tz_current tracks the REFINED EXTREMUM, not the root
                                #tzCur := #tzExtr;
                            END_IF;
                        END_IF;
                    END_FOR;

                    IF NOT #found THEN
                        // Final bracket check at tzMax
                        #polyValNew := "PolyEval"(p := #poly, n := 6, x := #tzMax);
                        #polyValCur := "PolyEval"(p := #poly, n := 6, x := #tzCur);
                        IF #polyValCur * #polyValNew < 0.0 THEN
                            #t := "ShrinkInterval"(p := #poly, n := 6, l := #tzCur, h := #tzMax);
                            // check_root (UDDU)
                            #h1arg := (#a0_a0 + #af_af) / (2.0 * #jMax_jMax) + (2.0 * #a0 * #t + #sjMax * #t * #t - #vd) / #sjMax;
                            IF #h1arg >= 0.0 THEN
                                #h1 := SQRT(#h1arg);
                                #num := 2.0 * #a0_p3 + 4.0 * #af_p3
                                    + 24.0 * #a0 * #sjMax * #t * (#aT + #sjMax * (#h1 + #t - #tf))
                                    + 6.0 * #a0_a0 * (#aT + #sjMax * (2.0 * #t - #tf))
                                    + 6.0 * (#a0_a0 + #af_af) * #sjMax * #h1
                                    + 12.0 * #aT * #sjMax * (#sjMax * #t * #t - #vd)
                                    + 12.0 * #jMax_jMax * (#sjMax * #t * #t * (#h1 + #t - #tf) - #tf * #v0 - #h1 * #vd);
                                #orig := -#pd - #num / #den_12jj;
                                #derivN := -(#a0 + #sjMax * #t) * (3.0 * (#h1 + #t) - 2.0 * #tf + (#a0 + 2.0 * #aT) / #sjMax);
                                IF ABS(#derivN) > 2.220446049250313E-16 THEN
                                    #t := #t - #orig / #derivN;
                                END_IF;
                            END_IF;
                            IF #t <= #tf THEN
                                #h1arg := (#a0_a0 + #af_af) / (2.0 * #jMax_jMax) + (#t * (2.0 * #a0 + #sjMax * #t) - #vd) / #sjMax;
                                IF #h1arg >= 0.0 THEN
                                    #h1 := SQRT(#h1arg);
                                    #profile.t[0] := #t;
                                    #profile.t[1] := 0.0;
                                    #profile.t[2] := #t + #a0 / #sjMax;
                                    #profile.t[3] := #tf - 2.0 * (#t + #h1) - (#a0 + #aT) / #sjMax;
                                    #profile.t[4] := #h1;
                                    #profile.t[5] := 0.0;
                                    #profile.t[6] := #h1 + #aT / #sjMax;
                                    #profile.j[0] := #sjMax;
                                    #profile.j[1] := 0.0;
                                    #profile.j[2] := -#sjMax;
                                    #profile.j[3] := 0.0;
                                    #profile.j[4] := -#sjMax;
                                    #profile.j[5] := 0.0;
                                    #profile.j[6] := #sjMax;
                                    #profile.direction := 1;
                                    #profile.controlSigns := 0;
                                    IF #profile.t[3] >= 1.0E-9 THEN
                                        #ok := "CheckProfile"(profile := #profile, p0 := #p0, v0 := #v0, a0 := #a0,
                                            pT := #pT, vT := #vT, aT := #aT, vMax := #vMaxMag, aMax := #aMaxMag, tf := #tf);
                                        IF #ok THEN
                                            #found := true;
                                        END_IF;
                                    END_IF;
                                END_IF;
                            END_IF;
                        ELSIF ABS(#polyValNew) < 8.0 * 2.220446049250313E-16 THEN
                            // Tiny value at tzMax: check_root directly
                            #t := #tzMax;
                            #h1arg := (#a0_a0 + #af_af) / (2.0 * #jMax_jMax) + (2.0 * #a0 * #t + #sjMax * #t * #t - #vd) / #sjMax;
                            IF #h1arg >= 0.0 THEN
                                #h1 := SQRT(#h1arg);
                                #num := 2.0 * #a0_p3 + 4.0 * #af_p3
                                    + 24.0 * #a0 * #sjMax * #t * (#aT + #sjMax * (#h1 + #t - #tf))
                                    + 6.0 * #a0_a0 * (#aT + #sjMax * (2.0 * #t - #tf))
                                    + 6.0 * (#a0_a0 + #af_af) * #sjMax * #h1
                                    + 12.0 * #aT * #sjMax * (#sjMax * #t * #t - #vd)
                                    + 12.0 * #jMax_jMax * (#sjMax * #t * #t * (#h1 + #t - #tf) - #tf * #v0 - #h1 * #vd);
                                #orig := -#pd - #num / #den_12jj;
                                #derivN := -(#a0 + #sjMax * #t) * (3.0 * (#h1 + #t) - 2.0 * #tf + (#a0 + 2.0 * #aT) / #sjMax);
                                IF ABS(#derivN) > 2.220446049250313E-16 THEN
                                    #t := #t - #orig / #derivN;
                                END_IF;
                            END_IF;
                            IF #t <= #tf THEN
                                #h1arg := (#a0_a0 + #af_af) / (2.0 * #jMax_jMax) + (#t * (2.0 * #a0 + #sjMax * #t) - #vd) / #sjMax;
                                IF #h1arg >= 0.0 THEN
                                    #h1 := SQRT(#h1arg);
                                    #profile.t[0] := #t;
                                    #profile.t[1] := 0.0;
                                    #profile.t[2] := #t + #a0 / #sjMax;
                                    #profile.t[3] := #tf - 2.0 * (#t + #h1) - (#a0 + #aT) / #sjMax;
                                    #profile.t[4] := #h1;
                                    #profile.t[5] := 0.0;
                                    #profile.t[6] := #h1 + #aT / #sjMax;
                                    #profile.j[0] := #sjMax;
                                    #profile.j[1] := 0.0;
                                    #profile.j[2] := -#sjMax;
                                    #profile.j[3] := 0.0;
                                    #profile.j[4] := -#sjMax;
                                    #profile.j[5] := 0.0;
                                    #profile.j[6] := #sjMax;
                                    #profile.direction := 1;
                                    #profile.controlSigns := 0;
                                    IF #profile.t[3] >= 1.0E-9 THEN
                                        #ok := "CheckProfile"(profile := #profile, p0 := #p0, v0 := #v0, a0 := #a0,
                                            pT := #pT, vT := #vT, aT := #aT, vMax := #vMaxMag, aMax := #aMaxMag, tf := #tf);
                                        IF #ok THEN
                                            #found := true;
                                        END_IF;
                                    END_IF;
                                END_IF;
                            END_IF;
                        END_IF;
                    END_IF;
                END_IF;
            END_IF;
        END_REGION

        REGION UDUD degree-6 polynomial — 2-level derivative-extrema seeding
            IF NOT #found THEN
                #ph1 := #af_af - 2.0 * #sjMax * (2.0 * #aT * #tf + #sjMax * #tf_tf - 3.0 * #vd);
                #ph2 := #af_p3 - 3.0 * #jMax_jMax * #g1 + 3.0 * #aT * #sjMax * #vd;
                #ph3 := 2.0 * #sjMax * #tf * #g1 + 3.0 * #vd_vd;
                #ph4 := #af_p4 - 8.0 * #af_p3 * #sjMax * #tf + 12.0 * #sjMax * (#sjMax * #ph3 + #af_af * #vd + 2.0 * #aT * #sjMax * (#g1 - #tf * #vd));
                #ph5 := #aT + #sjMax * #tf;

                #den_p2 := 4.0 * #jMax_jMax;
                #den_p3 := 6.0 * #jMax_jMax * #sjMax;
                #den_p4 := 24.0 * #jMax_jMax * #jMax_jMax;
                #den_p5 := 12.0 * #jMax_jMax * #jMax_jMax * #sjMax;
                #den_p6 := 144.0 * #jMax_jMax * #jMax_jMax * #jMax_jMax;
                // poly[0..6], 7 coefficients for degree-6 monic polynomial
                #poly[0] := 1.0;
                #poly[1] := (5.0 * #a0 - #ph5) / #sjMax;
                #poly[2] := (39.0 * #a0_a0 - #ph1 - 16.0 * #a0 * #ph5) / #den_p2;
                #poly[3] := (55.0 * #a0_p3 - 33.0 * #a0_a0 * #ph5 - 6.0 * #a0 * #ph1 + 2.0 * #ph2) / #den_p3;
                #poly[4] := (101.0 * #a0_p4 + #ph4 - 76.0 * #a0_p3 * #ph5 - 30.0 * #a0_a0 * #ph1 + 16.0 * #a0 * #ph2) / #den_p4;
                #poly[5] := (#a0 * (11.0 * #a0_p4 + #ph4 - 10.0 * #a0_p3 * #ph5 - 6.0 * #a0_a0 * #ph1 + 4.0 * #a0 * #ph2)) / #den_p5;
                #poly[6] := (11.0 * #a0_p6 - #af_p6 - 12.0 * #a0_p5 * #ph5 - 48.0 * #af_p3 * #jMax_jMax * #g1 - 9.0 * #a0_p4 * #ph1 + 72.0 * #jMax_jMax * #sjMax * (#sjMax * #g1 * #g1 - #vd_vd * #vd - 2.0 * #aT * #g1 * #vd) - 6.0 * #af_p4 * #sjMax * #vd - 36.0 * #af_af * #jMax_jMax * #vd_vd + 8.0 * #a0_p3 * #ph2 + 3.0 * #a0_a0 * #ph4) / #den_p6;

                #tzMin := -#a0 / #sjMax;
                IF #tzMin < 0.0 THEN
                    #tzMin := 0.0;
                END_IF;
                #tzMax := (#tf - #a0 / #sjMax) / 2.0;
                #num := (#saMax - #a0) / #sjMax;
                IF #num < #tzMax THEN
                    #tzMax := #num;
                END_IF;

                IF #tzMax > #tzMin THEN
                    // Monic degree-5 derivative of degree-6 monic poly:
                    // poly6 = [1, c1, c2, c3, c4, c5, c6]
                    // monic_deriv5 = [1, 5c1/6, 4c2/6, 3c3/6, 2c4/6, c5/6]
                    #derivArr[0] := 1.0;
                    #derivArr[1] := 5.0 * #poly[1] / 6.0;
                    #derivArr[2] := 4.0 * #poly[2] / 6.0;
                    #derivArr[3] := 3.0 * #poly[3] / 6.0;
                    #derivArr[4] := 2.0 * #poly[4] / 6.0;
                    #derivArr[5] := #poly[5] / 6.0;

                    // Monic degree-4 derivative of derivArr (degree-5 monic):
                    // monic_dderiv = [1, 4d1/5, 3d2/5, 2d3/5, d4/5]
                    #dderivArr[0] := 1.0;
                    #dderivArr[1] := 4.0 * #derivArr[1] / 5.0;
                    #dderivArr[2] := 3.0 * #derivArr[2] / 5.0;
                    #dderivArr[3] := 2.0 * #derivArr[3] / 5.0;
                    #dderivArr[4] := #derivArr[4] / 5.0;

                    // Standard derivative of dderivArr (degree-3):
                    // ddderiv[i] = (4-i)*dderivArr[i] for i=0..3
                    #ddderivArr[0] := 4.0 * #dderivArr[0];
                    #ddderivArr[1] := 3.0 * #dderivArr[1];
                    #ddderivArr[2] := 2.0 * #dderivArr[2];
                    #ddderivArr[3] := 1.0 * #dderivArr[3];

                    // Solve quartic for extrema of dderivArr
                    "SolveQuartic"(a := 1.0, b := #dderivArr[1], c := #dderivArr[2],
                                   d := #dderivArr[3], e := #dderivArr[4],
                                   roots => #qRoots, count => #qCount);

                    // Bubble-sort qRoots ascending
                    FOR #si := 0 TO #qCount - 2 DO
                        FOR #sj := 0 TO #qCount - 2 - #si DO
                            IF #qRoots[#sj] > #qRoots[#sj + 1] THEN
                                #sortTmp := #qRoots[#sj];
                                #qRoots[#sj] := #qRoots[#sj + 1];
                                #qRoots[#sj + 1] := #sortTmp;
                            END_IF;
                        END_FOR;
                    END_FOR;

                    // Level-1: walk dderiv extrema to find intervals where deriv changes sign
                    // Level-2: for each deriv sign-change interval, ShrinkInterval on deriv
                    //          to get zero, then bracket polynomial
                    #ddTzCur := #tzMin;
                    #tzCur := #tzMin;
                    FOR #qr := 0 TO #qCount - 1 DO
                        IF NOT #found THEN
                            #t := #qRoots[#qr];
                            IF #t < #tzMax THEN
                                // Newton refine on dderivArr
                                #derivVal := "PolyEval"(p := #dderivArr, n := 5, x := #t);
                                #ddVal    := "PolyEval"(p := #ddderivArr, n := 4, x := #t);
                                IF ABS(#derivVal) > 1.0E-14 AND ABS(#ddVal) > 2.220446049250313E-16 THEN
                                    #t := #t - #derivVal / #ddVal;
                                END_IF;
                                // Check if deriv changes sign between ddTzCur and t
                                #derivAtCur := "PolyEval"(p := #derivArr, n := 6, x := #ddTzCur);
                                #derivAtNew := "PolyEval"(p := #derivArr, n := 6, x := #t);
                                IF #derivAtCur * #derivAtNew < 0.0 THEN
                                    // Found interval where deriv=0: shrink to find it
                                    #derivZero := "ShrinkInterval"(p := #derivArr, n := 6, l := #ddTzCur, h := #t);
                                    IF #derivZero < #tzMax THEN
                                        // Use derivZero as seed for polynomial bracketing
                                        #polyValNew := "PolyEval"(p := #poly, n := 7, x := #derivZero);
                                        #polyValCur := "PolyEval"(p := #poly, n := 7, x := #tzCur);
                                        // threshold: 64 * |dderiv(derivZero)| * tol
                                        #ddVal := "PolyEval"(p := #dderivArr, n := 5, x := #derivZero);
                                        IF ABS(#polyValNew) < 64.0 * ABS(#ddVal) * 1.0E-14 THEN
                                            // Near-zero at derivZero: check_root
                                            #h1arg := (#af_af - #a0_a0) / #den_2jj - ((2.0 * #a0 + #sjMax * #derivZero) * #derivZero - #vd) / #sjMax;
                                            IF #h1arg >= 0.0 THEN
                                                #h1 := SQRT(#h1arg);
                                                #orig := -#pd + (#af_p3 - #a0_p3 + 3.0 * #a0_a0 * #sjMax * (#tf - 2.0 * #derivZero)) / #den_6jj + (2.0 * #a0 + #sjMax * #derivZero) * #derivZero * (#tf - #derivZero) + (#sjMax * #h1 - #aT) * #h1 * #h1 + #tf * #v0;
                                                #derivN := (#a0 + #sjMax * #derivZero) * (2.0 * (#aT + #sjMax * #tf) - 3.0 * #sjMax * (#h1 + #derivZero) - #a0) / #sjMax;
                                                IF ABS(#derivN) > 2.220446049250313E-16 THEN
                                                    #t := #derivZero - #orig / #derivN;
                                                ELSE
                                                    #t := #derivZero;
                                                END_IF;
                                                // second Newton step
                                                #h1arg := (#af_af - #a0_a0) / #den_2jj - ((2.0 * #a0 + #sjMax * #t) * #t - #vd) / #sjMax;
                                                IF #h1arg >= 0.0 THEN
                                                    #h1 := SQRT(#h1arg);
                                                    #orig := -#pd + (#af_p3 - #a0_p3 + 3.0 * #a0_a0 * #sjMax * (#tf - 2.0 * #t)) / #den_6jj + (2.0 * #a0 + #sjMax * #t) * #t * (#tf - #t) + (#sjMax * #h1 - #aT) * #h1 * #h1 + #tf * #v0;
                                                    IF ABS(#orig) > 1.0E-9 THEN
                                                        #derivN := (#a0 + #sjMax * #t) * (2.0 * (#aT + #sjMax * #tf) - 3.0 * #sjMax * (#h1 + #t) - #a0) / #sjMax;
                                                        IF ABS(#derivN) > 2.220446049250313E-16 THEN
                                                            #t := #t - #orig / #derivN;
                                                        END_IF;
                                                    END_IF;
                                                    #h1arg := (#af_af - #a0_a0) / #den_2jj - ((2.0 * #a0 + #sjMax * #t) * #t - #vd) / #sjMax;
                                                    IF #h1arg >= 0.0 THEN
                                                        #h1 := SQRT(#h1arg);
                                                        #profile.t[0] := #t;
                                                        #profile.t[1] := 0.0;
                                                        #profile.t[2] := #t + #a0 / #sjMax;
                                                        #profile.t[3] := #tf - 2.0 * (#t + #h1) + #ad / #sjMax;
                                                        #profile.t[4] := #h1;
                                                        #profile.t[5] := 0.0;
                                                        #profile.t[6] := #h1 - #aT / #sjMax;
                                                        #profile.j[0] := #sjMax;
                                                        #profile.j[1] := 0.0;
                                                        #profile.j[2] := -#sjMax;
                                                        #profile.j[3] := 0.0;
                                                        #profile.j[4] := #sjMax;
                                                        #profile.j[5] := 0.0;
                                                        #profile.j[6] := -#sjMax;
                                                        #profile.direction := 1;
                                                        #profile.controlSigns := 1;
                                                        IF #profile.t[3] >= 1.0E-9 THEN
                                                            #ok := "CheckProfile"(profile := #profile, p0 := #p0, v0 := #v0, a0 := #a0,
                                                                pT := #pT, vT := #vT, aT := #aT, vMax := #vMaxMag, aMax := #aMaxMag, tf := #tf);
                                                            IF #ok THEN
                                                                #found := true;
                                                            END_IF;
                                                        END_IF;
                                                    END_IF;
                                                END_IF;
                                            END_IF;
                                        ELSIF #polyValCur * #polyValNew < 0.0 THEN
                                            // Sign change: bracket polynomial
                                            #t := "ShrinkInterval"(p := #poly, n := 7, l := #tzCur, h := #derivZero);
                                            // check_root (UDUD, double Newton on pd)
                                            #h1arg := (#af_af - #a0_a0) / #den_2jj - ((2.0 * #a0 + #sjMax * #t) * #t - #vd) / #sjMax;
                                            IF #h1arg >= 0.0 THEN
                                                #h1 := SQRT(#h1arg);
                                                #orig := -#pd + (#af_p3 - #a0_p3 + 3.0 * #a0_a0 * #sjMax * (#tf - 2.0 * #t)) / #den_6jj + (2.0 * #a0 + #sjMax * #t) * #t * (#tf - #t) + (#sjMax * #h1 - #aT) * #h1 * #h1 + #tf * #v0;
                                                #derivN := (#a0 + #sjMax * #t) * (2.0 * (#aT + #sjMax * #tf) - 3.0 * #sjMax * (#h1 + #t) - #a0) / #sjMax;
                                                IF ABS(#derivN) > 2.220446049250313E-16 THEN
                                                    #t := #t - #orig / #derivN;
                                                END_IF;
                                                // second Newton step
                                                #h1arg := (#af_af - #a0_a0) / #den_2jj - ((2.0 * #a0 + #sjMax * #t) * #t - #vd) / #sjMax;
                                                IF #h1arg >= 0.0 THEN
                                                    #h1 := SQRT(#h1arg);
                                                    #orig := -#pd + (#af_p3 - #a0_p3 + 3.0 * #a0_a0 * #sjMax * (#tf - 2.0 * #t)) / #den_6jj + (2.0 * #a0 + #sjMax * #t) * #t * (#tf - #t) + (#sjMax * #h1 - #aT) * #h1 * #h1 + #tf * #v0;
                                                    IF ABS(#orig) > 1.0E-9 THEN
                                                        #derivN := (#a0 + #sjMax * #t) * (2.0 * (#aT + #sjMax * #tf) - 3.0 * #sjMax * (#h1 + #t) - #a0) / #sjMax;
                                                        IF ABS(#derivN) > 2.220446049250313E-16 THEN
                                                            #t := #t - #orig / #derivN;
                                                        END_IF;
                                                    END_IF;
                                                    #h1arg := (#af_af - #a0_a0) / #den_2jj - ((2.0 * #a0 + #sjMax * #t) * #t - #vd) / #sjMax;
                                                    IF #h1arg >= 0.0 THEN
                                                        #h1 := SQRT(#h1arg);
                                                        #profile.t[0] := #t;
                                                        #profile.t[1] := 0.0;
                                                        #profile.t[2] := #t + #a0 / #sjMax;
                                                        #profile.t[3] := #tf - 2.0 * (#t + #h1) + #ad / #sjMax;
                                                        #profile.t[4] := #h1;
                                                        #profile.t[5] := 0.0;
                                                        #profile.t[6] := #h1 - #aT / #sjMax;
                                                        #profile.j[0] := #sjMax;
                                                        #profile.j[1] := 0.0;
                                                        #profile.j[2] := -#sjMax;
                                                        #profile.j[3] := 0.0;
                                                        #profile.j[4] := #sjMax;
                                                        #profile.j[5] := 0.0;
                                                        #profile.j[6] := -#sjMax;
                                                        #profile.direction := 1;
                                                        #profile.controlSigns := 1;
                                                        IF #profile.t[3] >= 1.0E-9 THEN
                                                            #ok := "CheckProfile"(profile := #profile, p0 := #p0, v0 := #v0, a0 := #a0,
                                                                pT := #pT, vT := #vT, aT := #aT, vMax := #vMaxMag, aMax := #aMaxMag, tf := #tf);
                                                            IF #ok THEN
                                                                #found := true;
                                                            END_IF;
                                                        END_IF;
                                                    END_IF;
                                                END_IF;
                                            END_IF;
                                        END_IF;
                                        #tzCur := #derivZero;
                                    END_IF;
                                END_IF;
                                #ddTzCur := #t;
                            END_IF;
                        END_IF;
                    END_FOR;

                    IF NOT #found THEN
                        // Check final dderiv interval to tzMax
                        #derivAtCur := "PolyEval"(p := #derivArr, n := 6, x := #ddTzCur);
                        #derivAtNew := "PolyEval"(p := #derivArr, n := 6, x := #tzMax);
                        IF #derivAtCur * #derivAtNew < 0.0 THEN
                            #derivZero := "ShrinkInterval"(p := #derivArr, n := 6, l := #ddTzCur, h := #tzMax);
                            IF #derivZero < #tzMax THEN
                                #polyValNew := "PolyEval"(p := #poly, n := 7, x := #derivZero);
                                #polyValCur := "PolyEval"(p := #poly, n := 7, x := #tzCur);
                                IF #polyValCur * #polyValNew < 0.0 THEN
                                    #t := "ShrinkInterval"(p := #poly, n := 7, l := #tzCur, h := #derivZero);
                                    // check_root (UDUD, double Newton)
                                    #h1arg := (#af_af - #a0_a0) / #den_2jj - ((2.0 * #a0 + #sjMax * #t) * #t - #vd) / #sjMax;
                                    IF #h1arg >= 0.0 THEN
                                        #h1 := SQRT(#h1arg);
                                        #orig := -#pd + (#af_p3 - #a0_p3 + 3.0 * #a0_a0 * #sjMax * (#tf - 2.0 * #t)) / #den_6jj + (2.0 * #a0 + #sjMax * #t) * #t * (#tf - #t) + (#sjMax * #h1 - #aT) * #h1 * #h1 + #tf * #v0;
                                        #derivN := (#a0 + #sjMax * #t) * (2.0 * (#aT + #sjMax * #tf) - 3.0 * #sjMax * (#h1 + #t) - #a0) / #sjMax;
                                        IF ABS(#derivN) > 2.220446049250313E-16 THEN
                                            #t := #t - #orig / #derivN;
                                        END_IF;
                                        #h1arg := (#af_af - #a0_a0) / #den_2jj - ((2.0 * #a0 + #sjMax * #t) * #t - #vd) / #sjMax;
                                        IF #h1arg >= 0.0 THEN
                                            #h1 := SQRT(#h1arg);
                                            #orig := -#pd + (#af_p3 - #a0_p3 + 3.0 * #a0_a0 * #sjMax * (#tf - 2.0 * #t)) / #den_6jj + (2.0 * #a0 + #sjMax * #t) * #t * (#tf - #t) + (#sjMax * #h1 - #aT) * #h1 * #h1 + #tf * #v0;
                                            IF ABS(#orig) > 1.0E-9 THEN
                                                #derivN := (#a0 + #sjMax * #t) * (2.0 * (#aT + #sjMax * #tf) - 3.0 * #sjMax * (#h1 + #t) - #a0) / #sjMax;
                                                IF ABS(#derivN) > 2.220446049250313E-16 THEN
                                                    #t := #t - #orig / #derivN;
                                                END_IF;
                                            END_IF;
                                            #h1arg := (#af_af - #a0_a0) / #den_2jj - ((2.0 * #a0 + #sjMax * #t) * #t - #vd) / #sjMax;
                                            IF #h1arg >= 0.0 THEN
                                                #h1 := SQRT(#h1arg);
                                                #profile.t[0] := #t;
                                                #profile.t[1] := 0.0;
                                                #profile.t[2] := #t + #a0 / #sjMax;
                                                #profile.t[3] := #tf - 2.0 * (#t + #h1) + #ad / #sjMax;
                                                #profile.t[4] := #h1;
                                                #profile.t[5] := 0.0;
                                                #profile.t[6] := #h1 - #aT / #sjMax;
                                                #profile.j[0] := #sjMax;
                                                #profile.j[1] := 0.0;
                                                #profile.j[2] := -#sjMax;
                                                #profile.j[3] := 0.0;
                                                #profile.j[4] := #sjMax;
                                                #profile.j[5] := 0.0;
                                                #profile.j[6] := -#sjMax;
                                                #profile.direction := 1;
                                                #profile.controlSigns := 1;
                                                IF #profile.t[3] >= 1.0E-9 THEN
                                                    #ok := "CheckProfile"(profile := #profile, p0 := #p0, v0 := #v0, a0 := #a0,
                                                        pT := #pT, vT := #vT, aT := #aT, vMax := #vMaxMag, aMax := #aMaxMag, tf := #tf);
                                                    IF #ok THEN
                                                        #found := true;
                                                    END_IF;
                                                END_IF;
                                            END_IF;
                                        END_IF;
                                    END_IF;
                                END_IF;
                                #tzCur := #derivZero;
                            END_IF;
                        END_IF;

                        // Final poly bracket at tzMax
                        IF NOT #found THEN
                            #polyValNew := "PolyEval"(p := #poly, n := 7, x := #tzMax);
                            #polyValCur := "PolyEval"(p := #poly, n := 7, x := #tzCur);
                            IF #polyValCur * #polyValNew < 0.0 THEN
                                #t := "ShrinkInterval"(p := #poly, n := 7, l := #tzCur, h := #tzMax);
                                // check_root (UDUD, double Newton)
                                #h1arg := (#af_af - #a0_a0) / #den_2jj - ((2.0 * #a0 + #sjMax * #t) * #t - #vd) / #sjMax;
                                IF #h1arg >= 0.0 THEN
                                    #h1 := SQRT(#h1arg);
                                    #orig := -#pd + (#af_p3 - #a0_p3 + 3.0 * #a0_a0 * #sjMax * (#tf - 2.0 * #t)) / #den_6jj + (2.0 * #a0 + #sjMax * #t) * #t * (#tf - #t) + (#sjMax * #h1 - #aT) * #h1 * #h1 + #tf * #v0;
                                    #derivN := (#a0 + #sjMax * #t) * (2.0 * (#aT + #sjMax * #tf) - 3.0 * #sjMax * (#h1 + #t) - #a0) / #sjMax;
                                    IF ABS(#derivN) > 2.220446049250313E-16 THEN
                                        #t := #t - #orig / #derivN;
                                    END_IF;
                                    #h1arg := (#af_af - #a0_a0) / #den_2jj - ((2.0 * #a0 + #sjMax * #t) * #t - #vd) / #sjMax;
                                    IF #h1arg >= 0.0 THEN
                                        #h1 := SQRT(#h1arg);
                                        #orig := -#pd + (#af_p3 - #a0_p3 + 3.0 * #a0_a0 * #sjMax * (#tf - 2.0 * #t)) / #den_6jj + (2.0 * #a0 + #sjMax * #t) * #t * (#tf - #t) + (#sjMax * #h1 - #aT) * #h1 * #h1 + #tf * #v0;
                                        IF ABS(#orig) > 1.0E-9 THEN
                                            #derivN := (#a0 + #sjMax * #t) * (2.0 * (#aT + #sjMax * #tf) - 3.0 * #sjMax * (#h1 + #t) - #a0) / #sjMax;
                                            IF ABS(#derivN) > 2.220446049250313E-16 THEN
                                                #t := #t - #orig / #derivN;
                                            END_IF;
                                        END_IF;
                                        #h1arg := (#af_af - #a0_a0) / #den_2jj - ((2.0 * #a0 + #sjMax * #t) * #t - #vd) / #sjMax;
                                        IF #h1arg >= 0.0 THEN
                                            #h1 := SQRT(#h1arg);
                                            #profile.t[0] := #t;
                                            #profile.t[1] := 0.0;
                                            #profile.t[2] := #t + #a0 / #sjMax;
                                            #profile.t[3] := #tf - 2.0 * (#t + #h1) + #ad / #sjMax;
                                            #profile.t[4] := #h1;
                                            #profile.t[5] := 0.0;
                                            #profile.t[6] := #h1 - #aT / #sjMax;
                                            #profile.j[0] := #sjMax;
                                            #profile.j[1] := 0.0;
                                            #profile.j[2] := -#sjMax;
                                            #profile.j[3] := 0.0;
                                            #profile.j[4] := #sjMax;
                                            #profile.j[5] := 0.0;
                                            #profile.j[6] := -#sjMax;
                                            #profile.direction := 1;
                                            #profile.controlSigns := 1;
                                            IF #profile.t[3] >= 1.0E-9 THEN
                                                #ok := "CheckProfile"(profile := #profile, p0 := #p0, v0 := #v0, a0 := #a0,
                                                    pT := #pT, vT := #vT, aT := #aT, vMax := #vMaxMag, aMax := #aMaxMag, tf := #tf);
                                                IF #ok THEN
                                                    #found := true;
                                                END_IF;
                                            END_IF;
                                        END_IF;
                                    END_IF;
                                END_IF;
                            END_IF;
                        END_IF;
                    END_IF;
                END_IF;
            END_IF;
        END_REGION
    END_NETWORK
END_FUNCTION
