{
    S7_Author := "Martin C";
    S7_EditorMode := "SCL";
    S7_Family := "Ruckig";
    S7_Optimized := "TRUE";
    S7_Version := "0.2.1"
}
FUNCTION "AdvanceTime" : Void
    VAR_IN_OUT
        trajectory : _.typeTrajectory;
    END_VAR
    VAR_INPUT
        dt : LReal;
    END_VAR
    VAR_TEMP
        newTime : LReal;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        REGION Block header
            //==========================================================
            // Title:      AdvanceTime
            // Function:   Increment trajectory.currentTime by dt. NOT clamped to
            //             duration: past the end Ruckig keeps sampling and the
            //             axis follows the final state (StateAtTime extrapolates),
            //             so currentTime grows freely. No op if isValid is FALSE.
            // Family:     Ruckig
            // Author:     Martin C
            //==========================================================
        END_REGION

        REGION Advance
            IF NOT #trajectory.isValid THEN
                RETURN;
            END_IF;
            #newTime := #trajectory.currentTime + #dt;
            #trajectory.currentTime := #newTime;
        END_REGION
    END_NETWORK
END_FUNCTION
